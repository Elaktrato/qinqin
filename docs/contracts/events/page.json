 "requests": [
  {
   "name": "legacy: no limit, no page",
   "query": "since=1970-01-01T00:00:00Z&workspace=$ws",
   "status": 200,
   "form": "legacy"
  },
  {
   "name": "first page",
   "query": "limit=2&since=1970-01-01T00:00:00Z&workspace=$ws",
   "status": 200,
   "form": "page"
  },
  {
   "name": "first page, combined view",
   "query": "limit=2",
   "status": 200,
   "form": "page"
  },
  {
   "name": "continuation repeats the workspace",
   "query": "page=$next&workspace=$ws",
   "status": 200,
   "form": "page"
  },
