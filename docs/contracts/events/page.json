   "query": "page=$next&workspace=$otherWs",
   "status": 400,
   "error": "events_page_invalid"
  },
  {
   "name": "continuation repeats since",
   "query": "page=$next&workspace=$ws&since=1970-01-01T00:00:00Z",
   "status": 400,
   "error": "events_page_invalid"
