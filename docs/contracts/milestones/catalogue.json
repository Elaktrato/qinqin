{
  "version": 1,
  "rule": "milestones/catalogue",
  "note": "Families in catalogue order (the order breaks ties in lists). Ids are never renamed or removed; a release may only append families or thresholds. requires: the feature switch (null = always); hanOnly: Chinese and Japanese only; source: log = derived from the event log alone, replay = needs the schedule replay.",
  "idGrammar": {"keyPrefix": "milestone:", "threshold": "<family>:<n>, n decimal without sign or leading zeros and one of the family's thresholds", "level": "level-complete:<ownedLevelDeckId(packId, level)> = level-complete:d-lvl-<slug(packId)>-<fnv1a32(packId NUL level)> (decks/system-deck-ids.json)"},
  "families": [
    {"family": "reviews", "thresholds": [100, 500, 1000, 2500, 5000, 10000, 25000, 50000, 100000], "unit": "count", "requires": "flashcards", "hanOnly": false, "source": "log"},
    {"family": "words-studied", "thresholds": [10, 50, 100, 250, 500, 1000, 2500, 5000, 10000], "unit": "count", "requires": "flashcards", "hanOnly": false, "source": "log"},
    {"family": "words-mature", "thresholds": [10, 50, 100, 250, 500, 1000, 2500, 5000], "unit": "count", "requires": "flashcards", "hanOnly": false, "source": "replay"},
    {"family": "characters-learned", "thresholds": [10, 50, 100, 250, 500, 1000, 2000, 3000, 5000], "unit": "count", "requires": "flashcards", "hanOnly": true, "source": "replay"},
    {"family": "streak", "thresholds": [3, 7, 14, 30, 60, 100, 180, 365, 500, 730, 1000], "unit": "days", "requires": "flashcards", "hanOnly": false, "source": "log"},
    {"family": "days-active", "thresholds": [10, 30, 50, 100, 200, 365, 500, 1000], "unit": "days", "requires": null, "hanOnly": false, "source": "log"},
    {"family": "reading-hours", "thresholds": [1, 5, 10, 25, 50, 100, 250, 500, 1000], "unit": "hours", "requires": "reader", "hanOnly": false, "source": "log"},
    {"family": "journal-entries", "thresholds": [1, 10, 25, 50, 100, 250, 365, 500], "unit": "count", "requires": "journal", "hanOnly": false, "source": "log"},
    {"family": "level-complete", "thresholds": [], "unit": "count", "requires": "flashcards", "hanOnly": false, "source": "replay"}
  ],
  "titles": {"reviews": {"one": "{n} review", "other": "{n} reviews"}, "words-studied": {"one": "{n} word studied", "other": "{n} words studied"}, "words-mature": {"one": "{n} mature word", "other": "{n} mature words"}, "characters-learned": {"one": "{n} character learned", "other": "{n} characters learned"}, "streak": {"one": "{n}-day streak", "other": "{n}-day streak"}, "days-active": {"one": "{n} day active", "other": "{n} days active"}, "reading-hours": {"one": "{n} hour of reading", "other": "{n} hours of reading"}, "journal-entries": {"one": "{n} journal entry", "other": "{n} journal entries"}, "level-complete": {"one": "{level} complete", "other": "{level} complete"}},
  "cases": [
    {"op": "id", "name": "a count id", "family": "reviews", "threshold": 1000, "expect": "reviews:1000"},
    {"op": "id", "name": "a streak id", "family": "streak", "threshold": 7, "expect": "streak:7"},
    {"op": "id", "name": "a level id is the level deck id", "family": "level-complete", "packId": "hsk-words", "level": "HSK 1", "expect": "level-complete:d-lvl-hsk-words-b06fd2ac"},
    {"op": "id", "name": "a level id of an odd pack name", "family": "level-complete", "packId": "My Pack_2", "level": "Ünï", "expect": "level-complete:d-lvl-my-pack-2-71cc27e0"},
    {"op": "parse", "name": "a threshold id", "id": "reviews:1000", "expect": {"family": "reviews", "threshold": 1000}},
    {"op": "parse", "name": "the first journal entry", "id": "journal-entries:1", "expect": {"family": "journal-entries", "threshold": 1}},
    {"op": "parse", "name": "a level id", "id": "level-complete:d-lvl-hsk-words-b06fd2ac", "expect": {"family": "level-complete", "deckId": "d-lvl-hsk-words-b06fd2ac"}},
    {"op": "parse", "name": "a leading zero is unknown", "id": "reviews:0100", "expect": null},
    {"op": "parse", "name": "a number that is not a threshold is unknown", "id": "reviews:7", "expect": null},
    {"op": "parse", "name": "an unknown family is unknown", "id": "nope:1", "expect": null},
    {"op": "parse", "name": "no threshold", "id": "reviews:", "expect": null},
    {"op": "parse", "name": "exponent notation", "id": "reviews:1e3", "expect": null},
    {"op": "parse", "name": "a plus sign", "id": "reviews:+100", "expect": null},
    {"op": "parse", "name": "case matters", "id": "Reviews:100", "expect": null},
    {"op": "parse", "name": "a row key is not an id", "id": "milestone:reviews:100", "expect": null},
    {"op": "parse", "name": "a level id that is not a level deck id", "id": "level-complete:HSK 1", "expect": null},
    {"op": "parse", "name": "an empty level id", "id": "level-complete:", "expect": null},
    {"op": "parse", "name": "a threshold appended later would parse; this one is not in the catalogue", "id": "streak:2", "expect": null},
    {"op": "enabled", "name": "everything on, Han", "switches": {"flashcards": true, "reader": true, "journal": true}, "han": true, "expect": ["reviews", "words-studied", "words-mature", "characters-learned", "streak", "days-active", "reading-hours", "journal-entries", "level-complete"]},
    {"op": "enabled", "name": "everything on, not Han", "switches": {"flashcards": true, "reader": true, "journal": true}, "han": false, "expect": ["reviews", "words-studied", "words-mature", "streak", "days-active", "reading-hours", "journal-entries", "level-complete"]},
    {"op": "enabled", "name": "flashcards off", "switches": {"flashcards": false, "reader": true, "journal": true}, "han": true, "expect": ["days-active", "reading-hours", "journal-entries"]},
    {"op": "enabled", "name": "only flashcards", "switches": {"flashcards": true, "reader": false, "journal": false}, "han": true, "expect": ["reviews", "words-studied", "words-mature", "characters-learned", "streak", "days-active", "level-complete"]},
    {"op": "enabled", "name": "everything off: days-active stays", "switches": {"flashcards": false, "reader": false, "journal": false}, "han": false, "expect": ["days-active"]},
    {"op": "order", "name": "family order, then the higher threshold first, level ids by id", "ids": ["journal-entries:1", "level-complete:d-lvl-hsk-words-b06fd2ac", "streak:3", "reviews:100", "level-complete:d-lvl-hsk-words-19f1a7e4", "reviews:1000", "streak:30", "words-studied:10"], "expect": ["reviews:1000", "reviews:100", "words-studied:10", "streak:30", "streak:3", "journal-entries:1", "level-complete:d-lvl-hsk-words-19f1a7e4", "level-complete:d-lvl-hsk-words-b06fd2ac"]},
    {"op": "title", "name": "grouped thousands", "id": "reviews:1000", "expect": "1,000 reviews"},
    {"op": "title", "name": "singular", "id": "journal-entries:1", "expect": "1 journal entry"},
    {"op": "title", "name": "singular hour", "id": "reading-hours:1", "expect": "1 hour of reading"},
    {"op": "title", "name": "streak", "id": "streak:365", "expect": "365-day streak"},
    {"op": "title", "name": "a level by its label", "id": "level-complete:d-lvl-hsk-words-b06fd2ac", "levels": {"d-lvl-hsk-words-b06fd2ac": "HSK Words · HSK 1"}, "expect": "HSK Words · HSK 1 complete"},
    {"op": "title", "name": "a level whose label is unknown", "id": "level-complete:d-lvl-hsk-words-b06fd2ac", "levels": {}, "expect": null},
    {"op": "title", "name": "an unknown id has no title", "id": "reviews:7", "expect": null}
  ]
}
