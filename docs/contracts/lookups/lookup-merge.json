          {
            "entryId": 42,
            "count": 1,
            "firstAt": "2026-11-16T09:00:00.000Z",
            "lastAt": "2026-11-16T09:09:00.000Z",
            "sources": {
              "reader": 1
            },
            "books": [
              4,
