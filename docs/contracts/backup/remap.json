{
 "_doc": "Pure remapping of a restored archive (docs/contracts/backup/README.md). maps: source id -> target id per table (JSON keys are decimal strings). ops: card {key,data} -> {drop,key,data}; events {cards,events} -> {events:[{drop,workspaceId,payload}]} (every card row is registered first, then the events are mapped); pluginRow -> {drop,workspaceId,key,data} (qinqin-core note:<entryId> rows follow their entry, every other qinqin-core note: row (key not canonical, entryId missing or different, data not an object) is dropped; each case is a single row, so it is its own winner: the newest-wins rule for two notes on one target is tested in Go); workspaceSettings -> settings. Go: backup/remap_test.go.",
 "version": 1,
 "rule": "backup/remap",
 "cases": [
  {
   "name": "same server: identity",
   "op": "card",
   "maps": {
    "entries": {
     "1201": 1201
    }
   },
   "input": {
    "key": "card:c-vocab-1201",
    "data": {
     "id": "c-vocab-1201",
     "kind": "vocab",
     "entryId": 1201
    }
   },
   "expect": {
    "drop": false,
    "key": "card:c-vocab-1201",
    "data": {
     "id": "c-vocab-1201",
     "kind": "vocab",
     "entryId": 1201
    }
   },
   "note": ""
  },
  {
   "name": "shifted entry: derived id follows the entry",
   "op": "card",
   "maps": {
    "entries": {
     "1201": 1250
    }
   },
   "input": {
    "key": "card:c-reverse-1201",
    "data": {
     "id": "c-reverse-1201",
     "kind": "reverse",
     "entryId": 1201
    }
   },
   "expect": {
    "drop": false,
    "key": "card:c-reverse-1250",
    "data": {
     "id": "c-reverse-1250",
     "kind": "reverse",
     "entryId": 1250
    }
   },
   "note": ""
  },
  {
   "name": "ULID card keeps its id, entryId rewritten",
   "op": "card",
   "maps": {
    "entries": {
     "7": 9
    }
   },
   "input": {
    "key": "card:01JDULIDCARD0000000000001",
    "data": {
     "id": "01JDULIDCARD0000000000001",
     "kind": "vocab",
     "entryId": 7
    }
   },
   "expect": {
    "drop": false,
    "key": "card:01JDULIDCARD0000000000001",
    "data": {
     "id": "01JDULIDCARD0000000000001",
     "kind": "vocab",
     "entryId": 9
    }
   },
   "note": ""
  },
  {
   "name": "derived-looking id whose number differs from entryId is not derived",
   "op": "card",
   "maps": {
    "entries": {
     "5": 6
    }
   },
   "input": {
    "key": "card:c-vocab-99",
    "data": {
     "id": "c-vocab-99",
     "kind": "vocab",
     "entryId": 5
    }
   },
   "expect": {
    "drop": false,
    "key": "card:c-vocab-99",
    "data": {
     "id": "c-vocab-99",
     "kind": "vocab",
     "entryId": 6
    }
   },
   "note": ""
  },
  {
   "name": "unresolved entry drops the card",
   "op": "card",
   "maps": {
    "entries": {}
   },
   "input": {
    "key": "card:c-vocab-1201",
    "data": {
     "id": "c-vocab-1201",
     "kind": "vocab",
     "entryId": 1201
    }
   },
   "expect": {
    "drop": true
   },
   "note": ""
  },
