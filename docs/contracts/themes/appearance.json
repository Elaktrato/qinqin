{
 "version": 1,
 "rule": "themes/appearance",
 "_doc": "The user-global row qinqin-core / appearance (docs/contracts/themes/README.md, The appearance row). parse: the stored value (null = no row) to the settings the client applies; resolve: which slot, theme and accent are painted (themes: the installed themes with their accentChoices from derive); write: the value a client PUTs for a change.",
 "pluginId": "qinqin-core",
 "key": "appearance",
 "scope": "user-global",
 "defaults": {
  "version": 1,
  "mode": "system",
  "light": {
   "theme": "catppuccin-latte",
   "accent": "mauve"
  },
  "dark": {
   "theme": "catppuccin-mocha",
   "accent": "mauve"
  },
  "corners": "soft",
  "spacing": "comfortable",
  "hanziFont": "sans"
 },
 "adjustments": {
  "corners": {
   "sharp": 4,
   "soft": 10,
   "round": 16
  },
  "spacing": {
   "compact": 0.75,
   "comfortable": 1
  },
  "hanziFont": [
   "sans",
   "serif",
   "kai"
  ]
 },
 "row": {
  "version": 1,
  "mode": "dark",
  "light": {
   "theme": "rose-pine-dawn",
   "accent": "pine"
  },
  "dark": {
   "theme": "nord",
   "accent": "glacier"
  },
  "corners": "round",
  "spacing": "compact",
  "hanziFont": "kai"
 },
