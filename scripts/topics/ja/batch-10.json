 "c": [
  {"i":1351,"t":["function","communication"],"n":"Discourse marker 'come to think of it'; taught with connectives and conversation phrases, as B says."},
  {"i":1354,"t":["colours"],"s":{"3":["transport"]},"n":"Blue/green is colours; the traffic-light sense goes with transport; 'immature' (まだ青い) is marginal for learners and needs no entry."},
  {"i":1381,"t":["measures"],"s":{"1":["home"]},"n":"Learners first meet 台 as the counter for machines and vehicles; the 'stand/base' sense is the separate home sense."},
  {"i":1400,"t":["movement"],"n":"あふれる is an intransitive verb of overflowing (涙が/人であふれる), not a hand action; nature is only a loose association."},
  {"i":1411,"t":["feelings"],"n":"はしゃぐ describes high spirits and mood; the hobbies link is too loose."},
  {"i":1435,"t":["function","communication"],"n":"Discourse phrase 'now that you mention it'; same treatment as そう言や."},
  {"i":1445,"t":["actions"],"s":{"2":["feelings"]},"n":"General verb 'shut oneself in'; the N3 use 心のこもった (filled with feeling) belongs with feelings; home is a loose link."},
  {"i":1446,"t":["thinking","character"],"n":"Manner adverb of carelessness (うっかり忘れる), tied to memory and attention, not a degree/negation function word."},
  {"i":1482,"t":["calendar"],"n":"中止 is cancelling events and plans (試合が中止になる); it is not a hand or body action."}
 ],
 "d": [
  {"i":1353,"keep":[2],"n":"Race start (スタートライン, スタートする) is common and fits a sports unit."},
  {"i":1354,"keep":[3],"n":"信号が青 (green light) is everyday usage and taught with traffic."},
  {"i":1370,"keep":[],"n":"ま as 'room' appears mainly in compounds (居間, 茶の間), not standalone at this level."},
  {"i":1381,"keep":[],"n":"Stand/base is generic; it is not taught as a home-furniture word."},
  {"i":1394,"keep":[5],"n":"寿司のネタ (sushi topping) is a common sense and belongs in food."},
  {"i":1424,"keep":[2],"n":"Third school year (高校三年) is a common use taught in school."},
  {"i":1427,"keep":[2],"n":"写真をアップする (upload) is very common. Close-up is a specialist film sense, so drop it."},
  {"i":1439,"keep":[],"n":"Dissatisfaction (不足はない) is a less common sense; 不満 is the word taught for feelings."},
  {"i":1445,"keep":[2],"n":"心のこもった / 気持ちがこもる is a common, teachable expression of feeling."},
  {"i":1453,"keep":[2],"n":"Machine or computer trouble (エンジントラブル, システムトラブル) is common and fits technology."},
  {"i":1455,"keep":[3],"n":"会社のトップ (head of a company) is common. Home page is mostly the compound トップページ, so drop it."},
  {"i":1457,"keep":[4],"n":"Phone transfer (おつなぎします) is a standard phone and business phrase."},
  {"i":1493,"keep":[2],"n":"嘘をつく is a very common collocation and a core use of the つく reading."},
  {"i":1499,"keep":[2],"n":"Browser bookmark / お気に入り登録 is a common tech sense."}
 ]
