 "d": [
  {"i":1053,"keep":[],"n":"Making a pass is an idiomatic extension; a teacher would not teach 手を出す in a relationships unit"},
  {"i":1064,"keep":[],"n":"Generation of heat or power is technical and is still covered by the general 'occurrence' sense"},
  {"i":1076,"keep":[2],"n":"Food going bad is a very common everyday use; it fits the food unit"},
  {"i":1077,"keep":[3],"n":"Street names read どおり (中央通り) are common and belong in the city unit"},
  {"i":1089,"keep":[3],"n":"昼 meaning lunch (昼にする) is common; it fits the food unit"},
  {"i":1102,"keep":[2],"n":"Calling a young woman お姉さん is very common; it fits the people unit"},
  {"i":1133,"keep":[2],"n":"おやじ for a middle-aged man is common colloquial use; it fits the people unit"},
  {"i":1136,"keep":[4],"n":"Live (生放送, 生で見る) is a common sense; it fits the media unit"},
  {"i":1138,"keep":[2],"n":"とり as chicken meat (焼き鳥, 鳥肉) is common; it fits the food unit"},
  {"i":1143,"keep":[3],"n":"Tennis or volleyball net is a common sense; it fits the sports unit"},
  {"i":1149,"keep":[2],"n":"Calling a young woman お姉ちゃん is common; same as お姉さん"},
  {"i":1154,"keep":[2],"n":"いい人 meaning one's sweetheart (いい人がいる) is common; it fits relationships"},
  {"i":1161,"keep":[1],"n":"Potential 'can hold' is a basic common sense and belongs to actions, not to t"},
  {"i":1171,"keep":[3],"n":"お金を下ろす (withdraw money) is core vocabulary; it fits the money unit"},
  {"i":1178,"keep":[2],"n":"とし meaning a person's age (年を取る, お年寄り) is core; it fits the people unit"},
  {"i":1186,"keep":[4],"n":"Loyalty points (ポイントカード) are everyday shopping vocabulary in Japan"},
  {"i":1193,"keep":[1],"n":"お休み as a holiday or day off is very common; it fits calendar and schedules"}
