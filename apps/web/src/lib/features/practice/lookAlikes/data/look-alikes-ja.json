			"notes": {
				"シ": "Two dots stacked on the left; the long stroke rises from the bottom left.",
				"ツ": "Two dots side by side on top; the long stroke falls from the top right.",
				"ソ": "One dot on top; the long stroke falls from the top right.",
				"ン": "One dot on the left; the long stroke rises from the bottom left."
			},
			"marks": {}
		},
		{
			"members": [
				"ク",
				"ケ",
				"タ"
			],
			"notes": {
				"ク": "Two strokes; nothing inside.",
				"ケ": "The second stroke is a straight horizontal; the third falls from its middle.",
				"タ": "Like ク with a short stroke inside."
			},
			"marks": {}
		},
		{
			"members": [
				"ワ",
				"ウ",
				"フ"
