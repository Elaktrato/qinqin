{
 "version": 1,
 "rule": "packages/versioning",
 "_doc": "server cases: a sequence of pack operations on one test database (op import | uninstall | reconcile | restoreCopy; data names a variant of the test pack, the same name = the same content; failBuild makes the package writer fail for that step's builds), each followed by the builder draining its queue; expect lists catalogue rows by id (subset of members): hash is a label — equal labels mean equal contentHash, different labels different ones, \"\" the empty hash; files lists the revisions whose files exist under <data>/packages/<id>/ (retention keeps the previous one 7 days); error says whether the administrator's row carries error. client cases: the client rule packageAction (README.md, Client rule), applied in the order reset, deleted, pending, format, compare. Server cases: server/internal/datapkg (A6); client cases: apps/web/src/lib/packages/versioning.ts (C5).",
 "actions": [
  "keep",
  "download",
  "delete",
  "wait",
  "unsupported",
  "reset"
 ],
 "cases": [
  {
   "kind": "server",
   "name": "first import builds r1; an equal re-import changes nothing; a changed one builds r2",
   "steps": [
    {
     "do": {
      "op": "import",
      "type": "dictionary",
      "pack": "cedict",
      "language": "zh",
      "data": "v1"
     },
     "expect": [
      {
       "id": "lexicon.zh",
       "state": "ready",
       "revision": 1,
       "hash": "A",
       "files": [
        1
       ]
      }
     ]
    },
    {
     "do": {
      "op": "import",
      "type": "dictionary",
      "pack": "cedict",
      "language": "zh",
      "data": "v1"
     },
     "expect": [
      {
       "id": "lexicon.zh",
       "state": "ready",
       "revision": 1,
       "hash": "A",
       "files": [
        1
       ]
      }
     ]
    },
    {
     "do": {
      "op": "import",
      "type": "dictionary",
      "pack": "cedict",
      "language": "zh",
      "data": "v2"
     },
     "expect": [
      {
       "id": "lexicon.zh",
       "state": "ready",
       "revision": 2,
       "hash": "B",
       "files": [
        1,
        2
       ]
      }
     ]
    }
   ]
  },
  {
   "kind": "server",
   "name": "a second dictionary of the language rebuilds lexicon.<lang>; its uninstall rebuilds again",
   "steps": [
    {
     "do": {
      "op": "import",
      "type": "dictionary",
      "pack": "cedict",
      "language": "zh",
      "data": "v1"
