{
 "version": 1,
 "rule": "settings/workspace-settings",
 "maxSettingsBytes": 65536,
 "note": "\"$string:n\" is a JSON string of n x characters",
 "keys": [
  {
   "key": "reader",
   "shape": "object",
   "default": "see reader/display-settings.json",
   "owner": "apps/web/src/lib/features/reader/displaySettings.ts"
  },
  {
   "key": "hiddenDictionaries",
   "shape": "array of positive integer dictionary ids",
   "default": [],
   "owner": "apps/web/src/lib/workspace/dictionaryVisibility.ts"
  },
  {
   "key": "audioAutoplay",
   "shape": "boolean",
   "default": false,
   "owner": "apps/web/src/lib/audio/settings.ts"
  },
  {
   "key": "audioDeviceVoice",
   "shape": "boolean",
   "default": true,
   "owner": "apps/web/src/lib/audio/settings.ts"
  },
  {
   "key": "gradeHaptics",
   "shape": "boolean",
   "default": true,
   "owner": "apps/web/src/lib/native/haptics.ts"
  },
  {
   "key": "hints",
   "shape": "object: hint kind -> card kind -> \"always\" | \"hint\" | \"never\"",
   "default": "see cards/hints.json (its own parse rules; not repeated here)",
   "owner": "apps/web/src/lib/features/flashcards/face/hints.ts"
  },
  {
   "key": "starter",
   "shape": "object: {enabled: boolean, scope: \"base\" | \"all\"}",
   "default": "enabled false, scope base, member by member (see starter/README.md)",
   "owner": "apps/web/src/lib/starter/starter.ts"
  },
  {
   "key": "visualAids",
   "shape": "object: aid (pictures, toneColors, toneContour, anatomy) -> boolean",
   "default": "each switch true; see aids/visual-aids.json",
   "owner": "apps/web/src/lib/aids/visualAids.ts"
  },
  {
   "key": "romanisation",
   "shape": "object: romanisation type (pinyin, bopomofo, romaji) -> \"always\" | \"never\"",
   "default": "each type always; see settings/romanisation.json",
   "owner": "apps/web/src/lib/languages/romanisation.ts"
  },
  {
   "key": "interfaceLanguage",
   "shape": "string: a language tag (i18n/language-tags.json, not empty)",
   "default": "absent: use the account's interface language; see settings/interface-language.json",
   "owner": "apps/web/src/lib/i18n/workspaceLanguage.ts"
  }
 ],
 "parse": [
  {
   "name": "no keys: the defaults",
   "note": "autoplay off, device voice on, no hidden dictionaries",
   "settings": {},
   "expect": {
    "audio": {
     "autoplay": false,
     "deviceVoice": true
    },
    "hiddenDictionaries": [],
    "gradeHaptics": true
   }
  },
  {
   "name": "null settings",
   "note": "a workspace without a settings object reads as the defaults",
   "settings": null,
   "expect": {
    "audio": {
     "autoplay": false,
     "deviceVoice": true
    },
    "hiddenDictionaries": [],
    "gradeHaptics": true
   }
  },
  {
   "name": "every key set",
   "note": "booleans as stored; hiddenDictionaries as a set of ids",
   "settings": {
    "audioAutoplay": true,
    "audioDeviceVoice": false,
    "hiddenDictionaries": [
     3,
     7
    ]
   },
   "expect": {
    "audio": {
     "autoplay": true,
     "deviceVoice": false
    },
    "hiddenDictionaries": [
     3,
     7
    ],
    "gradeHaptics": true
   }
  },
  {
   "name": "a non-boolean falls back to the default",
   "note": "strings and numbers are not booleans",
   "settings": {
    "audioAutoplay": "true",
    "audioDeviceVoice": 0
   },
   "expect": {
    "audio": {
     "autoplay": false,
     "deviceVoice": true
    },
    "hiddenDictionaries": [],
    "gradeHaptics": true
   }
  },
  {
   "name": "malformed dictionary ids are ignored",
   "note": "only positive integers count; duplicates collapse",
   "settings": {
    "hiddenDictionaries": [
     3,
     "4",
     2.5,
     -1,
     0,
     3,
     null,
     9
    ]
   },
   "expect": {
    "audio": {
     "autoplay": false,
     "deviceVoice": true
    },
    "hiddenDictionaries": [
     3,
     9
    ],
    "gradeHaptics": true
   }
  },
  {
   "name": "hiddenDictionaries not a list",
   "note": "anything but an array hides nothing",
   "settings": {
    "hiddenDictionaries": {
     "3": true
    }
   },
   "expect": {
    "audio": {
     "autoplay": false,
     "deviceVoice": true
    },
    "hiddenDictionaries": [],
    "gradeHaptics": true
   }
  },
  {
   "name": "unknown keys are ignored by the readers",
   "note": "other keys (reader, a newer client's) do not change these values",
   "settings": {
    "reader": {
     "furigana": "all"
    },
    "futureKey": 1,
    "audioAutoplay": true
   },
   "expect": {
    "audio": {
     "autoplay": true,
     "deviceVoice": true
    },
    "hiddenDictionaries": [],
    "gradeHaptics": true
   }
  },
  {
   "name": "gradeHaptics off",
   "note": "the grading buzz switch; on unless stored false",
   "settings": {
    "gradeHaptics": false
   },
   "expect": {
    "audio": {
     "autoplay": false,
     "deviceVoice": true
    },
    "hiddenDictionaries": [],
    "gradeHaptics": false
   }
  },
  {
   "name": "gradeHaptics not a boolean",
   "note": "anything but a boolean reads as on",
   "settings": {
    "gradeHaptics": "no"
   },
   "expect": {
    "audio": {
     "autoplay": false,
     "deviceVoice": true
    },
    "hiddenDictionaries": [],
    "gradeHaptics": true
   }
  }
 ],
 "merge": [
  {
   "name": "update and add keys",
   "note": "RFC 7396: existing keys are replaced, new keys added, others kept",
   "stored": {
    "audioAutoplay": false,
    "reader": {
     "size": 2
    }
   },
   "patch": {
    "audioAutoplay": true,
    "hiddenDictionaries": [
     3
    ]
   },
   "expect": {
    "status": 200,
    "settings": {
     "audioAutoplay": true,
     "reader": {
      "size": 2
     },
     "hiddenDictionaries": [
      3
     ]
    }
   }
  },
  {
   "name": "null deletes a key",
   "note": "a null member removes the key",
   "stored": {
    "audioAutoplay": true,
    "audioDeviceVoice": false
   },
   "patch": {
    "audioDeviceVoice": null
   },
   "expect": {
    "status": 200,
    "settings": {
     "audioAutoplay": true
    }
   }
  },
  {
   "name": "nested objects merge",
   "note": "an object value is merged recursively; an array value replaces",
   "stored": {
    "reader": {
     "size": 2,
     "furigana": "all"
    },
    "hiddenDictionaries": [
     1,
     2
    ]
   },
   "patch": {
    "reader": {
     "furigana": "none",
     "font": "serif"
    },
    "hiddenDictionaries": [
     5
    ]
   },
   "expect": {
    "status": 200,
    "settings": {
     "reader": {
      "size": 2,
      "furigana": "none",
      "font": "serif"
     },
     "hiddenDictionaries": [
      5
     ]
    }
   }
  },
  {
   "name": "an empty patch changes nothing",
   "note": "{} is a valid patch",
   "stored": {
    "audioAutoplay": true
   },
   "patch": {},
   "expect": {
    "status": 200,
    "settings": {
     "audioAutoplay": true
    }
   }
  },
  {
   "name": "settings must be an object",
   "note": "an array (or a scalar) is 400 bad_request; nothing changes",
   "stored": {
    "audioAutoplay": true
   },
   "rawPatch": "[1]",
   "expect": {
    "status": 400,
    "error": "bad_request"
   }
  },
  {
   "name": "settings null and no name",
   "note": "a null settings member counts as absent: 400 bad_request",
   "stored": {
    "audioAutoplay": true
   },
   "rawPatch": "null",
   "expect": {
    "status": 400,
    "error": "bad_request"
   }
  },
  {
   "name": "a merged object over 64 KiB is 413 and changes nothing",
   "note": "the limit applies to the merged object (bytes of its JSON text), not to the patch",
   "stored": {
    "big": "$string:60000"
   },
   "patch": {
    "more": "$string:6000"
   },
   "expect": {
    "status": 413,
    "json": {
     "error": "too_large",
     "message": "The workspace settings would be larger than 64 KiB."
    }
   }
  },
  {
   "name": "a large value replaced by a small one",
   "note": "the limit is measured on the merged object: deleting a large key makes room",
   "stored": {
    "big": "$string:60000"
   },
   "patch": {
    "big": null,
    "small": "x"
   },
   "expect": {
    "status": 200,
    "settings": {
     "small": "x"
    }
   }
  },
  {
   "name": "one romanisation switch at a time",
   "note": "hiding pinyin keeps a stored bopomofo mode and every other key (#284)",
   "stored": {
    "romanisation": {
     "bopomofo": "never"
    },
    "hints": {
     "reading": {
      "vocab": "hint"
     }
    }
   },
   "patch": {
    "romanisation": {
     "pinyin": "never"
    }
   },
   "expect": {
    "status": 200,
    "settings": {
     "romanisation": {
      "bopomofo": "never",
      "pinyin": "never"
     },
     "hints": {
      "reading": {
       "vocab": "hint"
      }
     }
    }
   }
  },
  {
   "name": "a workspace's interface language",
   "note": "set beside the other keys (#297)",
   "stored": {
    "romanisation": {
     "pinyin": "never"
    }
   },
   "patch": {
    "interfaceLanguage": "de"
   },
   "expect": {
    "status": 200,
    "settings": {
     "romanisation": {
      "pinyin": "never"
     },
     "interfaceLanguage": "de"
    }
   }
  },
  {
   "name": "back to the account's interface language",
   "note": "null removes the key: \"use my account setting\" (#297)",
   "stored": {
    "interfaceLanguage": "de",
    "audioAutoplay": true
   },
   "patch": {
    "interfaceLanguage": null
   },
   "expect": {
    "status": 200,
    "settings": {
     "audioAutoplay": true
    }
   }
  }
 ]
}
