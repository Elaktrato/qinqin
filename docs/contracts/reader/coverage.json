      "end": 7,
      "surface": "2024",
      "lemma": "2024",
      "entries": [
       9
      ]
     },
     {
      "start": 7,
      "end": 8,
      "surface": "年",
      "lemma": "年",
      "entries": [
       2
      ]
     }
    ]
   ],
   "states": {
    "1": "known",
    "2": "new",
    "9": "new"
   },
