 "c": [
  {"i":4913,"t":["money","shopping","qualities"],"n":"得 is profit/advantage (得する, 損得); お得 'good deal' is everyday shopping vocabulary, so shopping is a real teaching unit too."},
  {"i":4916,"t":["qualities","arts"],"n":"美 is abstract beauty as a quality and an aesthetic concept (美術, 美意識); personal looks belong to 美しい/美人, not the bare noun."},
  {"i":4921,"t":["sports","actions"],"s":{"2":["school"]},"n":"Fist punch is the core sense; the hole punch (穴あけパンチ) is common stationery; the drink sense is rare for learners (ポンチ is usual), so it needs no entry."},
  {"i":4958,"t":["numbers"],"s":{"3":["money"],"4":["qualities"]},"n":"Minus/subtraction/negative number is the core; deficit and drawback are common senses in other units; electrical charge is peripheral, so science is dropped."},
  {"i":4988,"t":["media","arts"],"n":"スター means a celebrity; a star in the sky is 星, so the celestial sense is rare and needs no entry."},
  {"i":5044,"t":["money"],"n":"Treasure is riches and valuables; 'qualities' was only a loose association."}
 ],
 "d": [
  {"i":4905,"keep":[2],"n":"料金プラン / phone and payment plans are everyday words; fits a money or shopping unit"},
  {"i":4921,"keep":[],"n":"the hole punch is usually 穴あけパンチ; bare パンチ as stationery is marginal at this level"},
  {"i":4923,"keep":[],"n":"作 meaning crop appears mainly in compounds (豊作, 不作); standalone use is rare for learners"},
  {"i":4950,"keep":[2],"n":"パン生地 and ピザ生地 (dough, batter) are common and taught with cooking"},
  {"i":4958,"keep":[3],"n":"a money loss (今月はマイナス) is common and fits money; the 'drawback' sense is abstract evaluation, not a qualities-unit item"},
  {"i":4961,"keep":[],"n":"for fund-raising learners meet 募金; this use of 募集 is secondary at this level"},
  {"i":4995,"keep":[],"n":"じき is learned as 'soon'; the 'nearby' sense is rare (すぐそこ is used instead)"},
  {"i":4996,"keep":[],"n":"'light' as in ライトブルー or a light meal is a modifier prefix, not a word taught in a qualities unit"},
  {"i":5004,"keep":[2],"n":"応急処置 and medical 処置 are common and belong in a health unit"},
  {"i":5023,"keep":[2],"n":"オープンな性格 (open, frank) is common and taught in a personality unit"},
  {"i":5028,"keep":[],"n":"現金な人 (mercenary) is an idiomatic figurative use, uncommon for learners"},
  {"i":5040,"keep":[2],"n":"ホール meaning a restaurant's dining floor (ホールスタッフ) is common in restaurant and part-time job contexts"}
 ]
