{
 "version": 1,
 "rule": "reader/sentence-sources",
 "doc": "Sentence sources (#280): a saved book sentence keeps its book, chapter and position (the word's code-point range in the paragraph). check, merge and detach: Go server/internal/sentences/source_contract_test.go; link, at and label: web lib/entry/sentenceSource.test.ts and lib/features/reader/route.test.ts.",
 "limits": { "maxParagraph": 100000, "maxOffset": 100000 },
 "check": [
  { "name": "a word in one of the caller's books", "entryLanguage": "zh",
    "book": { "owner": "caller", "language": "zh", "chapterCount": 3 },
    "source": { "bookId": 5, "chapter": 2, "paragraph": 4, "start": 10, "end": 12 }, "want": "ok" },
  { "name": "the first word of the first paragraph", "entryLanguage": "zh",
    "book": { "owner": "caller", "language": "zh", "chapterCount": 1 },
    "source": { "bookId": 5, "chapter": 0, "paragraph": 0, "start": 0, "end": 1 }, "want": "ok" },
  { "name": "the largest position", "entryLanguage": "ja",
    "book": { "owner": "caller", "language": "ja", "chapterCount": 1 },
    "source": { "bookId": 5, "chapter": 0, "paragraph": 100000, "start": 99999, "end": 100000 }, "want": "ok" },
  { "name": "another user's book", "entryLanguage": "zh",
    "book": { "owner": "other", "language": "zh", "chapterCount": 3 },
    "source": { "bookId": 5, "chapter": 0, "paragraph": 0, "start": 0, "end": 2 }, "want": "invalid" },
  { "name": "no such book", "entryLanguage": "zh",
    "book": null,
    "source": { "bookId": 99, "chapter": 0, "paragraph": 0, "start": 0, "end": 2 }, "want": "invalid" },
  { "name": "a book of another language", "entryLanguage": "zh",
    "book": { "owner": "caller", "language": "ja", "chapterCount": 3 },
    "source": { "bookId": 5, "chapter": 0, "paragraph": 0, "start": 0, "end": 2 }, "want": "invalid" },
  { "name": "a chapter the book does not have", "entryLanguage": "zh",
    "book": { "owner": "caller", "language": "zh", "chapterCount": 3 },
    "source": { "bookId": 5, "chapter": 3, "paragraph": 0, "start": 0, "end": 2 }, "want": "invalid" },
  { "name": "a negative chapter", "entryLanguage": "zh",
    "book": { "owner": "caller", "language": "zh", "chapterCount": 3 },
    "source": { "bookId": 5, "chapter": -1, "paragraph": 0, "start": 0, "end": 2 }, "want": "invalid" },
  { "name": "a negative paragraph", "entryLanguage": "zh",
    "book": { "owner": "caller", "language": "zh", "chapterCount": 3 },
    "source": { "bookId": 5, "chapter": 0, "paragraph": -1, "start": 0, "end": 2 }, "want": "invalid" },
  { "name": "a paragraph over the limit", "entryLanguage": "zh",
    "book": { "owner": "caller", "language": "zh", "chapterCount": 3 },
    "source": { "bookId": 5, "chapter": 0, "paragraph": 100001, "start": 0, "end": 2 }, "want": "invalid" },
  { "name": "an empty range", "entryLanguage": "zh",
    "book": { "owner": "caller", "language": "zh", "chapterCount": 3 },
    "source": { "bookId": 5, "chapter": 0, "paragraph": 0, "start": 4, "end": 4 }, "want": "invalid" },
  { "name": "a reversed range", "entryLanguage": "zh",
    "book": { "owner": "caller", "language": "zh", "chapterCount": 3 },
    "source": { "bookId": 5, "chapter": 0, "paragraph": 0, "start": 5, "end": 4 }, "want": "invalid" },
  { "name": "a negative start", "entryLanguage": "zh",
    "book": { "owner": "caller", "language": "zh", "chapterCount": 3 },
    "source": { "bookId": 5, "chapter": 0, "paragraph": 0, "start": -1, "end": 4 }, "want": "invalid" },
  { "name": "an end over the limit", "entryLanguage": "zh",
    "book": { "owner": "caller", "language": "zh", "chapterCount": 3 },
    "source": { "bookId": 5, "chapter": 0, "paragraph": 0, "start": 0, "end": 100001 }, "want": "invalid" }
 ],
 "merge": [
  { "name": "a new sentence stores the source", "existing": null,
    "source": { "bookId": 5, "chapter": 1, "paragraph": 2, "start": 3, "end": 5 },
    "want": { "kind": "book", "bookId": 5, "title": "Book five", "chapter": 1, "paragraph": 2, "start": 3, "end": 5 } },
  { "name": "a new sentence without a source has none", "existing": null, "source": null, "want": null },
  { "name": "an own sentence without a source takes the new one", "existing": { "own": true, "source": null },
    "source": { "bookId": 5, "chapter": 1, "paragraph": 2, "start": 3, "end": 5 },
    "want": { "kind": "book", "bookId": 5, "title": "Book five", "chapter": 1, "paragraph": 2, "start": 3, "end": 5 } },
  { "name": "an own sentence with a source keeps it",
    "existing": { "own": true, "source": { "bookId": 6, "chapter": 0, "paragraph": 7, "start": 1, "end": 3 } },
    "source": { "bookId": 5, "chapter": 1, "paragraph": 2, "start": 3, "end": 5 },
    "want": { "kind": "book", "bookId": 6, "title": "Book six", "chapter": 0, "paragraph": 7, "start": 1, "end": 3 } },
  { "name": "a save without a source changes nothing",
    "existing": { "own": true, "source": { "bookId": 6, "chapter": 0, "paragraph": 7, "start": 1, "end": 3 } },
    "source": null,
    "want": { "kind": "book", "bookId": 6, "title": "Book six", "chapter": 0, "paragraph": 7, "start": 1, "end": 3 } },
  { "name": "a pack sentence gets no source", "existing": { "own": false, "source": null },
    "source": { "bookId": 5, "chapter": 1, "paragraph": 2, "start": 3, "end": 5 }, "want": null }
 ],
 "detach": [
  { "name": "the deleted book's sentences keep title and place, without the book",
    "deleted": [5],
    "sentences": [
     { "id": 1, "source": { "kind": "book", "bookId": 5, "title": "Book five", "chapter": 1, "paragraph": 2, "start": 3, "end": 5 } },
     { "id": 2, "source": { "kind": "book", "bookId": 6, "title": "Book six", "chapter": 0, "paragraph": 0, "start": 0, "end": 1 } },
     { "id": 3, "source": null }
    ],
    "want": [
     { "id": 1, "source": { "kind": "book", "bookId": null, "title": "Book five", "chapter": 1, "paragraph": 2, "start": 3, "end": 5 }, "moved": true },
     { "id": 2, "source": { "kind": "book", "bookId": 6, "title": "Book six", "chapter": 0, "paragraph": 0, "start": 0, "end": 1 }, "moved": false },
     { "id": 3, "source": null, "moved": false }
    ] },
  { "name": "a workspace delete detaches all its books",
    "deleted": [5, 6],
    "sentences": [
     { "id": 1, "source": { "kind": "book", "bookId": 5, "title": "Book five", "chapter": 1, "paragraph": 2, "start": 3, "end": 5 } },
     { "id": 2, "source": { "kind": "book", "bookId": 6, "title": "Book six", "chapter": 0, "paragraph": 0, "start": 0, "end": 1 } }
    ],
    "want": [
     { "id": 1, "source": { "kind": "book", "bookId": null, "title": "Book five", "chapter": 1, "paragraph": 2, "start": 3, "end": 5 }, "moved": true },
     { "id": 2, "source": { "kind": "book", "bookId": null, "title": "Book six", "chapter": 0, "paragraph": 0, "start": 0, "end": 1 }, "moved": true }
    ] }
 ],
 "link": [
  { "name": "a book sentence links to its place",
    "source": { "kind": "book", "bookId": 5, "title": "Book five", "chapter": 2, "paragraph": 4, "start": 10, "end": 12 },
    "want": "/reader/book/5/2?at=4:10-12" },
  { "name": "the first chapter",
    "source": { "kind": "book", "bookId": 7, "title": "", "chapter": 0, "paragraph": 0, "start": 0, "end": 1 },
    "want": "/reader/book/7/0?at=0:0-1" },
  { "name": "a deleted book has no link",
    "source": { "kind": "book", "bookId": null, "title": "Book five", "chapter": 2, "paragraph": 4, "start": 10, "end": 12 },
    "want": null },
  { "name": "an unknown kind has no link",
    "source": { "kind": "course", "bookId": 5, "title": "Lesson", "chapter": 0, "paragraph": 0, "start": 0, "end": 1 },
    "want": null }
 ],
 "at": [
  { "name": "paragraph and range", "at": "4:10-12", "want": { "paragraph": 4, "start": 10, "end": 12 } },
  { "name": "the start of the chapter", "at": "0:0-1", "want": { "paragraph": 0, "start": 0, "end": 1 } },
  { "name": "missing", "at": null, "want": null },
  { "name": "empty", "at": "", "want": null },
  { "name": "no range", "at": "4", "want": null },
  { "name": "an empty range", "at": "4:3-3", "want": null },
  { "name": "a reversed range", "at": "4:5-3", "want": null },
  { "name": "a sign", "at": "+4:1-2", "want": null },
  { "name": "a fraction", "at": "4.5:1-2", "want": null },
  { "name": "an offset over the limit", "at": "4:1-100001", "want": null },
  { "name": "extra parts", "at": "4:1-2:3", "want": null }
 ],
 "label": [
  { "name": "title and chapter (one-based)", "source": { "kind": "book", "bookId": 5, "title": "Book five", "chapter": 2, "paragraph": 4, "start": 10, "end": 12 },
    "want": { "title": "Book five", "chapter": 3, "linked": true } },
  { "name": "an untitled book", "source": { "kind": "book", "bookId": 5, "title": "  ", "chapter": 0, "paragraph": 0, "start": 0, "end": 1 },
    "want": { "title": null, "chapter": 1, "linked": true } },
  { "name": "a deleted book keeps its title, without a link", "source": { "kind": "book", "bookId": null, "title": "Book five", "chapter": 0, "paragraph": 0, "start": 0, "end": 1 },
    "want": { "title": "Book five", "chapter": 1, "linked": false } }
 ]
}
