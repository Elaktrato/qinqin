{
 "version": 1,
 "rule": "languages/profiles",
 "note": "One profile per language the app knows, and the fallback (code \"*\") for every other code. A code resolves by its primary subtag, case-insensitive (zh-TW -> zh). romanisations (#284): the reading types that are romanisation, each with its own Show switch (settings/romanisation.json). A profile says what a language has, not how its reading code works. resolve: code -> the profile's code. writingSystems (#204): the scripts of the writing-system trainer, ids of its script data (hiragana, katakana, hangul, cyrillic); an empty list hides the trainer.",
 "profiles": [
  {
   "code": "zh",
   "script": "han",
   "readings": ["pinyin"],
   "romanisations": ["pinyin", "bopomofo"],
   "segmentation": "dictionary",
   "tones": true,
   "strokes": true,
   "kana": false,
   "variants": true,
   "cardKinds": ["vocab", "sentence", "writing", "tone", "reverse", "cloze"],
   "practiceModes": ["decks", "levels", "characterMap"],
   "writingSystems": []
  },
  {
   "code": "ja",
   "script": "han",
   "readings": ["kana"],
   "romanisations": ["romaji"],
   "segmentation": "dictionary",
   "tones": false,
