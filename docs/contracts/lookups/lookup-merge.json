    {
      "name": "the 501st item evicts the least recent (tie: smaller count, then larger entryId)",
      "op": "evict",
      "input": {
        "generate": {
          "items": 500,
          "entryIdFrom": 1000,
          "lastAtFrom": "2026-10-01T00:00:00Z",
          "stepMs": 60000,
          "count": 2,
          "same": {
            "entryIds": [
              1000,
              1001,
              1002
