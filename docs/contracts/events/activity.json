   "cells": [
    {
     "day": "2026-11-01",
     "workspace": 1,
     "type": "journal",
     "points": 1,
     "raw": 1
    },
    {
     "day": "2026-11-02",
     "workspace": 1,
     "type": "journal",
     "points": 1,
     "raw": 1
    }
   ]
  },
  {
   "name": "journal: a numeric entryId never counts",
   "note": "only JSON strings count (json_type text); a day with none has no cell",
