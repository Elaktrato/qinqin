{
 "version": 1,
 "rule": "reader/display-settings",
 "defaults": { "bookRuby": true, "readings": "never", "smartThreshold": 80, "rubyScale": 0.55, "font": "default", "highlightWords": false, "saveSentences": false },
 "cases": [
  { "name": "no settings, no local pref", "settings": null, "localFurigana": null,
    "expect": { "bookRuby": true, "readings": "never", "smartThreshold": 80, "rubyScale": 0.55, "font": "default", "highlightWords": false, "saveSentences": false } },
  { "name": "no reader key", "settings": { "audioAutoplay": true }, "localFurigana": null,
    "expect": { "bookRuby": true, "readings": "never", "smartThreshold": 80, "rubyScale": 0.55, "font": "default", "highlightWords": false, "saveSentences": false } },
  { "name": "reader is not an object", "settings": { "reader": 5 }, "localFurigana": false,
    "expect": { "bookRuby": false, "readings": "never", "smartThreshold": 80, "rubyScale": 0.55, "font": "default", "highlightWords": false, "saveSentences": false } },
  { "name": "a full valid object", "settings": { "reader": { "version": 1, "bookRuby": false, "readings": "smart", "smartThreshold": 70, "rubyScale": 0.75, "font": "kai" } }, "localFurigana": true,
    "expect": { "bookRuby": false, "readings": "smart", "smartThreshold": 70, "rubyScale": 0.75, "font": "kai", "highlightWords": false, "saveSentences": false } },
  { "name": "every field invalid falls back per field", "settings": { "reader": { "bookRuby": "yes", "readings": "sometimes", "smartThreshold": "high", "rubyScale": "big", "font": "comic" } }, "localFurigana": null,
    "expect": { "bookRuby": true, "readings": "never", "smartThreshold": 80, "rubyScale": 0.55, "font": "default", "highlightWords": false, "saveSentences": false } },
  { "name": "bookRuby falls back to the local furigana pref", "settings": { "reader": { "readings": "always" } }, "localFurigana": false,
    "expect": { "bookRuby": false, "readings": "always", "smartThreshold": 80, "rubyScale": 0.55, "font": "default", "highlightWords": false, "saveSentences": false } },
  { "name": "the setting wins over the local pref", "settings": { "reader": { "bookRuby": true } }, "localFurigana": false,
    "expect": { "bookRuby": true, "readings": "never", "smartThreshold": 80, "rubyScale": 0.55, "font": "default", "highlightWords": false, "saveSentences": false } },
  { "name": "threshold below the range is clamped", "settings": { "reader": { "smartThreshold": 3 } }, "localFurigana": null,
    "expect": { "bookRuby": true, "readings": "never", "smartThreshold": 10, "rubyScale": 0.55, "font": "default", "highlightWords": false, "saveSentences": false } },
  { "name": "threshold above the range is clamped", "settings": { "reader": { "smartThreshold": 250 } }, "localFurigana": null,
    "expect": { "bookRuby": true, "readings": "never", "smartThreshold": 100, "rubyScale": 0.55, "font": "default", "highlightWords": false, "saveSentences": false } },
  { "name": "a fractional threshold is rounded", "settings": { "reader": { "smartThreshold": 72.6 } }, "localFurigana": null,
    "expect": { "bookRuby": true, "readings": "never", "smartThreshold": 73, "rubyScale": 0.55, "font": "default", "highlightWords": false, "saveSentences": false } },
  { "name": "a non-finite threshold falls back", "settings": { "reader": { "smartThreshold": null } }, "localFurigana": null,
    "expect": { "bookRuby": true, "readings": "never", "smartThreshold": 80, "rubyScale": 0.55, "font": "default", "highlightWords": false, "saveSentences": false } },
  { "name": "ruby scale snaps to the nearest allowed value", "settings": { "reader": { "rubyScale": 0.72 } }, "localFurigana": null,
    "expect": { "bookRuby": true, "readings": "never", "smartThreshold": 80, "rubyScale": 0.75, "font": "default", "highlightWords": false, "saveSentences": false } },
  { "name": "highlightWords true is kept", "settings": { "reader": { "highlightWords": true } }, "localFurigana": null,
    "expect": { "bookRuby": true, "readings": "never", "smartThreshold": 80, "rubyScale": 0.55, "font": "default", "highlightWords": true, "saveSentences": false } },
  { "name": "highlightWords that is not a boolean falls back to false", "settings": { "reader": { "highlightWords": "yes" } }, "localFurigana": null,
    "expect": { "bookRuby": true, "readings": "never", "smartThreshold": 80, "rubyScale": 0.55, "font": "default", "highlightWords": false, "saveSentences": false } }
 ],
 "fontStacks": {
  "families": "system families only, every stack ends with a generic family",
  "langs": ["zh", "ja"],
  "fonts": ["default", "sans", "serif", "kai"]
 }
}
