{
  "version": 1,
  "rule": "lookups/prompt",
  "_doc": "The 'you keep looking these up' prompt (docs/contracts/lookups/README.md): items with count >= 3 whose entry is new, count desc, lastAt desc, entryId asc, at most 10. states maps entry id -> familiarity (missing = new). expect = entry ids in order. Web: lib/lookups/lookups.test.ts.",
  "cases": [
    {
      "name": "count 2 is excluded, count 3 with no card is included",
      "input": {
        "row": {
          "version": 1,
          "clearedAt": null,
          "items": [
            {
              "entryId": 1,
              "count": 2,
              "firstAt": "2026-11-10T09:00:00Z",
              "lastAt": "2026-11-12T18:30:00Z",
              "sources": {
                "reader": 2
              },
              "books": []
            },
            {
              "entryId": 2,
              "count": 3,
              "firstAt": "2026-11-10T09:00:00Z",
              "lastAt": "2026-11-12T18:30:00Z",
              "sources": {
                "reader": 3
              },
              "books": []
            }
          ]
        },
        "states": {
          "1": "new",
          "2": "new"
        }
      },
      "expect": [
        2
      ]
    },
    {
      "name": "an entry with a card is excluded",
      "input": {
        "row": {
          "version": 1,
          "clearedAt": null,
          "items": [
            {
              "entryId": 1,
              "count": 5,
              "firstAt": "2026-11-10T09:00:00Z",
              "lastAt": "2026-11-12T18:30:00Z",
              "sources": {
                "reader": 5
