    "start": "22:00",
    "end": "08:00"
   },
   "at": "08:00",
   "inside": false
  },
  {
   "quiet": {
    "start": "22:00",
    "end": "08:00"
   },
   "at": "22:00",
   "inside": true
  },
  {
   "quiet": {
    "start": "22:00",
    "end": "08:00"
   },
   "at": "12:00",
   "inside": false
  },
  {
   "quiet": {
    "start": "13:00",
