{
  "login_bad_credentials": {
    "status": 401,
    "headers": {"Content-Type": "application/json"},
    "body": {"error": "bad_credentials", "message": "Wrong username or password."}
  },
  "rate_limited": {
    "status": 429,
    "headers": {"Retry-After": "6", "Content-Type": "application/json"},
    "body": {"error": "rate_limited", "message": "Too many sign-in attempts. Try again in 6 seconds."}
  },
  "rate_limited_minutes": {
    "status": 429,
    "headers": {"Retry-After": "900", "Content-Type": "application/json"},
    "body": {"error": "rate_limited", "message": "Too many sign-in attempts. Try again in 15 minutes."}
  },
  "register_rate_limited": {
    "status": 429,
    "headers": {"Retry-After": "6", "Content-Type": "application/json"},
    "body": {"error": "rate_limited", "message": "Too many attempts. Try again in 6 seconds."}
  },
  "busy": {
    "status": 503,
    "headers": {"Retry-After": "2", "Content-Type": "application/json"},
    "body": {"error": "busy", "message": "The server is busy. Try again in a moment."}
  },
  "register_admin_required": {
    "status": 403,
    "headers": {"Content-Type": "application/json"},
    "body": {"error": "admin_required", "message": "Registration needs an administrator."}
  },
  "register_username_taken": {
    "status": 409,
    "headers": {"Content-Type": "application/json"},
    "body": {"error": "username_taken", "message": "That username is taken."}
  },
  "bad_request": {
    "status": 400,
    "headers": {"Content-Type": "application/json"},
    "body": {"error": "bad_request", "message": "Malformed request body."}
  },
  "too_large": {
    "status": 413,
    "headers": {"Content-Type": "application/json"},
    "body": {"error": "too_large", "message": "Request body too large."}
  }
}
