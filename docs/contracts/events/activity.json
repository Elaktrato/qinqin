{
 "version": 1,
 "rule": "events/activity",
 "note": "cells of GET /api/stats/activity for the built-in activity rules (rules lists the core table, server/internal/stats/rules.go: type, feature and the scoring; labels and wordings are client catalogue text); events default to workspace 1",
 "rules": [
  {
   "type": "review",
   "rule": {
    "feature": "flashcards"
   }
  },
  {
   "type": "read",
   "rule": {
    "feature": "reader",
    "measure": {
     "field": "seconds",
     "min": 30,
     "max": 7200
    },
    "pointsPer": 300
   }
  },
  {
   "type": "journal",
   "rule": {
    "feature": "journal",
    "distinctBy": "entryId"
   }
  },
  {
   "type": "script",
   "rule": {
    "feature": "scripts"
   }
  },
  {
   "type": "grammar",
   "rule": {
    "feature": "grammar",
    "distinctBy": "point"
   }
  },
  {
   "type": "drill.tone-pairs",
   "rule": {
    "feature": "practice"
   }
  },
  {
   "type": "drill.conjugation",
   "rule": {
    "feature": "practice"
   }
  },
  {
   "type": "drill.measure-words",
   "rule": {
    "feature": "practice"
   }
  },
  {
   "type": "drill.counters",
   "rule": {
    "feature": "practice"
   }
  },
  {
   "type": "drill.counter-readings",
   "rule": {
    "feature": "practice"
   }
  },
  {
   "type": "drill.look-alikes",
   "rule": {
    "feature": "practice"
   }
  }
 ],
