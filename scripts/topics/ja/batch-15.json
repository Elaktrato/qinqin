 "d": [
  {"i":2103,"keep":[],"n":"Reliance (頼みの綱) is mostly figurative; it isn't taught as a relationships word"},
  {"i":2106,"keep":[4],"n":"お礼 as a thank-you gift is common and fits gift-giving"},
  {"i":2107,"keep":[],"n":"Awakening to the truth is figurative"},
  {"i":2108,"keep":[2],"n":"喉に違和感がある (physical unease) is common in body and health talk"},
  {"i":2115,"keep":[2,3],"n":"笑みを浮かべる and 思い浮かべる are both common, clearly distinct uses"},
  {"i":2119,"keep":[2],"n":"Excess suffix ～すぎ (食べすぎ) is a core grammar point"},
  {"i":2122,"keep":[],"n":"Sympathize sense is mostly set phrases (お察しします) and fits thinking anyway"},
  {"i":2123,"keep":[2],"n":"気が晴れる (feel refreshed) is common and is about mood"},
  {"i":2129,"keep":[4,6],"n":"クラスで浮く and お金が浮く are both common colloquial uses in distinct themes"},
  {"i":2135,"keep":[],"n":"Typical/representative is an abstract extension that a qualities unit would not teach"},
  {"i":2143,"keep":[],"n":"Food spoiling is normally written 傷む, a different word in practice"},
  {"i":2144,"keep":[],"n":"Settlement and habitual-way senses are less common; the word is taught as 'rule'"},
  {"i":2148,"keep":[5],"n":"なんか引っかかる (it bothers me) is common; being tricked isn't a law-unit word"},
  {"i":2154,"keep":[1,4],"n":"Division in arithmetic and 水で割る for drinks are both common and distinct"},
  {"i":2157,"keep":[2],"n":"Taking on an opponent or team is a common sports use"},
  {"i":2167,"keep":[],"n":"Ticking time and etching into memory are figurative or literary"},
  {"i":2171,"keep":[1],"n":"お手伝いさん (housemaid) is a common job word"},
  {"i":2176,"keep":[5],"n":"Suffix -性 (安全性) is very common word formation; 'nature of a person' standalone is literary"},
  {"i":2181,"keep":[2],"n":"Joining a group (仲間に加わる) is common social use"},
  {"i":2183,"keep":[2,3],"n":"愛が冷める and 冷めた人 are common; feelings and personality uses are distinct"},
  {"i":2192,"keep":[2],"n":"地震に備える (disaster preparedness) is a core safety-unit use"},
  {"i":2193,"keep":[],"n":"意見を寄せる and 思いを寄せる are formal or literary at this level"},
  {"i":2203,"keep":[2],"n":"飲み込みが早い (quick to grasp) is a common understanding use"},
  {"i":2207,"keep":[],"n":"Magic sense belongs mostly to fiction; it isn't taught in a culture unit"},
  {"i":2214,"keep":[3],"n":"お返しです for change at the register is very common"},
  {"i":2220,"keep":[3,4],"n":"Aircraft (機内, 機長) and the aircraft counter are common; 'chance' standalone is literary"},
  {"i":2230,"keep":[3],"n":"怪我を負う is common; responsibility isn't specifically a work-unit sense"},
  {"i":2237,"keep":[],"n":"Frugality sense is dated or regional"},
  {"i":2238,"keep":[],"n":"Waning moon is a narrow use that isn't taught in a nature unit"},
  {"i":2243,"keep":[2],"n":"The real match (本番に強い) is common sports talk"},
  {"i":2246,"keep":[1],"n":"Rivers merging (川が合流する) is a common, distinct geographic use"},
  {"i":2250,"keep":[2],"n":"最終 as the last train is very common"}
 ]
