{
  "version": 1,
  "rule": "milestones/seen-rows",
  "note": "rows: keyed rows of one workspace as the pull gives them (decoded data). seen: id -> {seenAt, reachedDay} of every live milestone: row (the key minus the prefix, whatever the data says); seenAt is a non-empty string or null, reachedDay a real YYYY-MM-DD or null. listed: the seen ids this client can title, in catalogue order (family order, higher threshold first).",
  "cases": [
    {"name": "a live row is seen; its data gives the date", "rows": [{"key": "milestone:reviews:1000", "data": {"version": 1, "id": "reviews:1000", "seenAt": "2026-11-17T08:00:00.000Z", "reachedDay": "2026-11-03"}, "deletedAt": null}], "expect": {"seen": {"reviews:1000": {"seenAt": "2026-11-17T08:00:00.000Z", "reachedDay": "2026-11-03"}}, "listed": ["reviews:1000"]}},
    {"name": "a tombstone is not seen", "note": "deletedAt set: absent (sync model); no client writes one", "rows": [{"key": "milestone:reviews:1000", "data": {"version": 1, "id": "reviews:1000", "seenAt": "2026-11-17T08:00:00.000Z", "reachedDay": "2026-11-03"}, "deletedAt": "2026-11-18T00:00:00Z"}], "expect": {"seen": {}, "listed": []}},
    {"name": "seen by the key alone: another version, a mismatching id, missing members", "rows": [{"key": "milestone:streak:7", "data": {"version": 2, "id": "streak:7", "seenAt": "2026-11-17T08:00:00.000Z", "reachedDay": "2026-11-01", "extra": [1]}, "deletedAt": null}, {"key": "milestone:reviews:100", "data": {"version": 1, "id": "reviews:500", "seenAt": "2026-11-17T08:00:00.000Z", "reachedDay": "2026-10-01"}, "deletedAt": null}, {"key": "milestone:words-studied:10", "data": {"version": 1}, "deletedAt": null}, {"key": "milestone:days-active:10", "data": "not an object", "deletedAt": null}, {"key": "milestone:journal-entries:1", "data": null, "deletedAt": null}], "expect": {"seen": {"streak:7": {"seenAt": "2026-11-17T08:00:00.000Z", "reachedDay": "2026-11-01"}, "reviews:100": {"seenAt": "2026-11-17T08:00:00.000Z", "reachedDay": "2026-10-01"}, "words-studied:10": {"seenAt": null, "reachedDay": null}, "days-active:10": {"seenAt": null, "reachedDay": null}, "journal-entries:1": {"seenAt": null, "reachedDay": null}}, "listed": ["reviews:100", "words-studied:10", "streak:7", "days-active:10", "journal-entries:1"]}},
    {"name": "an unknown id (a newer client's catalogue) is seen and kept, never listed", "rows": [{"key": "milestone:reviews:7", "data": {"version": 1, "id": "reviews:7", "seenAt": "2026-11-17T08:00:00.000Z", "reachedDay": "2026-11-03"}, "deletedAt": null}, {"key": "milestone:quiz-streak:5", "data": {"version": 1, "id": "quiz-streak:5", "seenAt": "2026-11-17T08:00:00.000Z", "reachedDay": "2026-11-03"}, "deletedAt": null}], "expect": {"seen": {"reviews:7": {"seenAt": "2026-11-17T08:00:00.000Z", "reachedDay": "2026-11-03"}, "quiz-streak:5": {"seenAt": "2026-11-17T08:00:00.000Z", "reachedDay": "2026-11-03"}}, "listed": []}},
    {"name": "an invalid reachedDay or seenAt reads as null (the history falls back)", "rows": [{"key": "milestone:reviews:100", "data": {"version": 1, "id": "reviews:100", "seenAt": 17, "reachedDay": "2026-02-30"}, "deletedAt": null}, {"key": "milestone:reviews:500", "data": {"version": 1, "id": "reviews:500", "seenAt": "", "reachedDay": "20261103"}, "deletedAt": null}], "expect": {"seen": {"reviews:100": {"seenAt": null, "reachedDay": null}, "reviews:500": {"seenAt": null, "reachedDay": null}}, "listed": ["reviews:500", "reviews:100"]}},
    {"name": "other keys and an empty id are not milestone rows", "rows": [{"key": "goals:workspace", "data": {"version": 1}, "deletedAt": null}, {"key": "milestone:", "data": {}, "deletedAt": null}, {"key": "milestones:reviews:100", "data": {}, "deletedAt": null}], "expect": {"seen": {}, "listed": []}}
  ]
}
