{
  "version": 1,
  "rule": "lookups/merge",
  "_doc": "Merge, remove, clear and staleAfterClear of the qinqin-core lookups row (docs/contracts/lookups/README.md). Rows are given as stored data (null = missing) and expected as written back ({...extra, version:1, clearedAt, items}). generate builds items entryIdFrom+i, lastAt = firstAt = lastAtFrom + i*stepMs, count, sources (default {reader: count}), books (default []); same overrides lastAt/count of the listed ids. evict expects the merged length, absent/present entry ids and the first item; size expects the JSON text (JSON.stringify) to stay within maxBytes. Web: lib/lookups/lookups.test.ts.",
  "cases": [
    {
      "name": "new word",
      "op": "merge",
      "input": {
        "row": {
          "version": 1,
          "clearedAt": null,
          "items": []
        },
        "hits": [
          {
            "entryId": 42,
            "at": "2026-11-16T09:00:00.000Z",
            "source": "reader",
            "bookId": 17
          }
        ]
      },
      "expect": {
        "version": 1,
        "clearedAt": null,
        "items": [
          {
            "entryId": 42,
            "count": 1,
            "firstAt": "2026-11-16T09:00:00.000Z",
            "lastAt": "2026-11-16T09:00:00.000Z",
            "sources": {
              "reader": 1
            },
            "books": [
              17
            ]
          }
        ]
      }
    },
    {
      "name": "missing row: first hit starts the history",
      "op": "merge",
      "input": {
        "row": null,
        "hits": [
          {
            "entryId": 42,
            "at": "2026-11-16T09:00:00.000Z",
            "source": "search"
          }
        ]
      },
      "expect": {
        "version": 1,
        "clearedAt": null,
        "items": [
          {
            "entryId": 42,
            "count": 1,
            "firstAt": "2026-11-16T09:00:00.000Z",
            "lastAt": "2026-11-16T09:00:00.000Z",
            "sources": {
              "search": 1
            },
            "books": []
          }
        ]
      }
    },
    {
      "name": "second lookup 11 minutes later counts",
      "op": "merge",
      "input": {
        "row": {
          "version": 1,
          "clearedAt": null,
          "items": [
            {
              "entryId": 42,
              "count": 1,
              "firstAt": "2026-11-16T09:00:00.000Z",
              "lastAt": "2026-11-16T09:00:00.000Z",
              "sources": {
                "reader": 1
              },
              "books": [
                17
              ]
            }
          ]
        },
        "hits": [
          {
            "entryId": 42,
            "at": "2026-11-16T09:11:00.000Z",
            "source": "search"
          }
        ]
      },
      "expect": {
        "version": 1,
        "clearedAt": null,
        "items": [
          {
            "entryId": 42,
            "count": 2,
            "firstAt": "2026-11-16T09:00:00.000Z",
            "lastAt": "2026-11-16T09:11:00.000Z",
            "sources": {
              "reader": 1,
              "search": 1
            },
            "books": [
              17
            ]
          }
        ]
      }
    },
    {
      "name": "lookup 9 minutes later is a repeat: lastAt and books move, count stays",
