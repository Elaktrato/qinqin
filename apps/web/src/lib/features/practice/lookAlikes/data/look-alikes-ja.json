				"ン": "The short stroke lies flat on the top left; the long stroke rises from the bottom left."
			},
			"marks": {}
		},
		{
			"members": [
				"ク",
				"ケ",
				"タ"
			],
			"notes": {
				"ク": "Two strokes; nothing inside.",
				"ケ": "The second stroke is a straight horizontal; the third falls from its middle.",
				"タ": "Like ク with a short stroke inside."
