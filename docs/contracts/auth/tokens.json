{
  "_doc": "Personal access token routes and every refusal of the token gate (docs/contracts/auth/README.md, Personal access tokens). <token> stands for the qq_pat_ string shown once by create; no real token is ever written here. Bodies are compared with real server responses by server/internal/api/contract_tokens_test.go (keys and value types per element) and decoded by apps/web/src/lib/account/tokensFormat.test.ts. The management routes need a full session; an access token on them is token_not_allowed.",
  "create": {
    "request": {"method": "POST", "path": "/api/account/tokens", "body": {"name": "cron sync", "scope": "write", "workspaceId": null, "expiresInDays": 90, "currentPassword": "<current>"}},
    "status": 201,
    "body": {"token": "<token>", "accessToken": {"id": 4, "name": "cron sync", "hint": "3f9a1c", "scope": "write", "workspaceId": null, "createdAt": "2026-11-16T12:00:00Z", "expiresAt": "2027-02-14T12:00:00Z", "lastUsedAt": null, "expired": false}}
  },
  "create_limited": {
    "request": {"method": "POST", "path": "/api/account/tokens", "body": {"name": "reader export", "scope": "read", "workspaceId": 3, "expiresInDays": 7, "currentPassword": "<current>"}},
    "status": 201,
    "body": {"token": "<token>", "accessToken": {"id": 5, "name": "reader export", "hint": "08b2e7", "scope": "read", "workspaceId": 3, "createdAt": "2026-11-16T12:01:00Z", "expiresAt": "2026-11-23T12:01:00Z", "lastUsedAt": null, "expired": false}}
  },
  "list": {
    "request": {"method": "GET", "path": "/api/account/tokens"},
    "status": 200,
    "body": {"accessTokens": [
      {"id": 5, "name": "reader export", "hint": "08b2e7", "scope": "read", "workspaceId": 3, "createdAt": "2026-11-16T12:01:00Z", "expiresAt": "2026-11-23T12:01:00Z", "lastUsedAt": null, "expired": false},
      {"id": 4, "name": "cron sync", "hint": "3f9a1c", "scope": "write", "workspaceId": null, "createdAt": "2026-11-16T12:00:00Z", "expiresAt": "2027-02-14T12:00:00Z", "lastUsedAt": "2026-11-16T12:05:00Z", "expired": false}
    ]}
  },
  "revoke_one": {
    "request": {"method": "DELETE", "path": "/api/account/tokens/{id}"},
    "status": 204,
    "body": null
  },
  "revoke_all": {
    "request": {"method": "DELETE", "path": "/api/account/tokens"},
    "status": 200,
    "body": {"revoked": 2}
  },
  "not_allowed": {
    "request": {"method": "GET", "path": "/api/auth/me", "auth": "access token"},
    "status": 403,
    "body": {"error": "token_not_allowed", "message": "Access tokens cannot be used on this route."}
  },
  "read_only": {
    "request": {"method": "POST", "path": "/api/events/batch", "auth": "read access token"},
    "status": 403,
    "body": {"error": "token_read_only", "message": "This access token is read-only."}
  },
  "workspace": {
    "request": {"method": "GET", "path": "/api/sync/pull", "auth": "access token limited to one workspace"},
    "status": 403,
    "body": {"error": "token_workspace", "message": "This access token is limited to one workspace and this request is outside it."}
  },
  "limit": {
    "request": {"method": "POST", "path": "/api/account/tokens", "body": {"name": "one too many", "scope": "read", "expiresInDays": 30, "currentPassword": "<current>"}},
    "status": 409,
    "body": {"error": "token_limit", "message": "You already have 20 access tokens. Revoke one first."}
  },
  "invalid_name": {
    "request": {"method": "POST", "path": "/api/account/tokens", "body": {"name": "   ", "scope": "read", "expiresInDays": 30, "currentPassword": "<current>"}},
    "status": 422,
    "body": {"error": "invalid_token_request", "message": "The name must be 1 to 64 characters."}
  },
  "invalid_days": {
    "request": {"method": "POST", "path": "/api/account/tokens", "body": {"name": "forever", "scope": "read", "expiresInDays": 366, "currentPassword": "<current>"}},
    "status": 422,
    "body": {"error": "invalid_token_request", "message": "The expiry must be 1 to 365 days."}
  },
  "wrong_password": {
    "request": {"method": "POST", "path": "/api/account/tokens", "body": {"name": "cron sync", "scope": "read", "expiresInDays": 30, "currentPassword": "<wrong>"}},
    "status": 403,
    "body": {"error": "wrong_password", "message": "The current password is wrong."}
  },
  "unauthorized_expired": {
    "request": {"method": "GET", "path": "/api/workspaces", "auth": "expired, revoked or unknown access token"},
    "status": 401,
    "body": {"error": "unauthorized", "message": "Sign in to continue."}
  },
  "foreign_revoke": {
    "request": {"method": "DELETE", "path": "/api/account/tokens/{id of another user's token}"},
    "status": 404,
    "body": {"error": "not_found", "message": "No such access token."}
  }
}
