{
 "version": 1,
 "rule": "drills/drills",
 "note": "Drills (v0.9.0 drills framework): ids, item keys, the event of one answer and how a client reads it, and the drills a server and a client count as activity. Schedules: schedule.json; rounds: pick.json; EXP, streak and activity: counting.json.",
 "constants": {
  "eventPrefix": "drill.",
  "feature": "practice",
  "maxIdLength": 32,
  "maxItemLength": 200,
  "reservedIds": [
   "weakest"
  ],
  "grades": [
   1,
   2,
   3,
   4
  ]
 },
 "registry": ["tone-pairs", "conjugation", "measure-words", "counters", "counter-readings"],
 "ids": [
  {
   "name": "a one-word id",
   "id": "conjugation",
   "valid": true
  },
  {
   "name": "words joined by hyphens",
   "id": "tone-pairs",
   "valid": true
  },
  {
   "name": "a digit after the first letter",
   "id": "a1",
   "valid": true
  },
  {
   "name": "32 characters",
   "id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
   "valid": true
  },
  {
   "name": "33 characters",
   "id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
   "valid": false
  },
  {
   "name": "empty",
   "id": "",
   "valid": false
  },
  {
   "name": "a capital",
   "id": "Tone",
   "valid": false
  },
  {
   "name": "an underscore",
   "id": "tone_pairs",
   "valid": false
  },
  {
   "name": "a leading hyphen",
   "id": "-tone",
   "valid": false
  },
  {
   "name": "a trailing hyphen",
   "id": "tone-",
   "valid": false
  },
  {
   "name": "two hyphens",
   "id": "tone--pairs",
   "valid": false
  },
  {
   "name": "a leading digit",
   "id": "1tone",
   "valid": false
  },
  {
   "name": "a dot",
   "id": "drill.tone",
   "valid": false
  },
  {
   "name": "the weakest round's name is reserved",
   "id": "weakest",
   "valid": false
  },
  {
   "name": "not a string",
   "id": 7,
   "valid": false
  }
 ],
