   "variants": false,
   "cardKinds": ["vocab", "sentence", "writing", "reverse", "cloze"],
   "practiceModes": ["decks", "levels", "characterMap"],
   "writingSystems": ["hiragana", "katakana"]
  },
  {
   "code": "es",
