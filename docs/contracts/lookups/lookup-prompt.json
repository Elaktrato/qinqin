              "count": 3,
              "firstAt": "2026-11-10T09:00:00Z",
              "lastAt": "2026-11-12T18:30:00Z",
              "sources": {
                "reader": 3
              },
              "books": []
            }
          ]
        },
        "states": {
          "1": "learning",
          "2": "new"
        }
      },
      "expect": [
        2
      ]
    },
    {
      "name": "an entry marked known is excluded",
      "input": {
        "row": {
          "version": 1,
          "clearedAt": null,
          "items": [
