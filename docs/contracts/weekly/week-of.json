    {
      "name": "a weekday maps to its Monday",
      "op": "normalize",
      "today": "2026-11-18",
      "param": "2026-11-18",
      "expect": "2026-11-16"
    },
    {
      "name": "a Sunday of an earlier week maps to its Monday",
      "op": "normalize",
      "today": "2026-11-18",
      "param": "2026-11-08",
      "expect": "2026-11-02"
    },
    {
      "name": "a future week is the current week",
