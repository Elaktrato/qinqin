# runtime data (SQLite database, installed packs)
/data/
/server/data/

# local-only seed packs (unclear licences; never committed)
/plugins/data-local/

# official syllabus inputs for scripts/prepare-hsk-syllabus.mjs: never commit
*.syllabus.pdf
syllabus*.pdf
syllabus*.txt
syllabus*.tsv

# local tooling scratch
/.superpowers/
/.claude/worktrees/

# generated web build copied into the embed dir (Docker/CI)
/server/internal/webdist/dist/*
!/server/internal/webdist/dist/.gitkeep
