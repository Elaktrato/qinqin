{
  "version": 1,
  "rule": "milestones/catalogue",
  "note": "Families in catalogue order (the order breaks ties in lists). Ids are never renamed or removed; a release may only append families or thresholds. requires: the feature switch (null = always); hanOnly: Chinese and Japanese only; source: log = derived from the event log alone, replay = needs the schedule replay, course = needs the workspace's filled course (#225).",
  "idGrammar": {"keyPrefix": "milestone:", "threshold": "<family>:<n>, n decimal without sign or leading zeros and one of the family's thresholds", "level": "level-complete:<ownedLevelDeckId(packId, level)> = level-complete:d-lvl-<slug(packId)>-<fnv1a32(packId NUL level)> (decks/system-deck-ids.json)", "course": "course-started:<course>, course-graduated:<course>; course-unit:<course>:<unit>, course-section:<course>:<section>, course-script:<course>:<script> (ids as courses/README.md: ^[a-z0-9]+(-[a-z0-9]+)*$, at most 64 bytes); course-characters:<course>:<n>, course-words:<course>:<n> (n one of the family's thresholds). <course> is a pack id: ^[A-Za-z0-9._-]{1,128}$"},
  "families": [
    {"family": "reviews", "thresholds": [100, 500, 1000, 2500, 5000, 10000, 25000, 50000, 100000], "unit": "count", "requires": "flashcards", "hanOnly": false, "source": "log"},
    {"family": "words-studied", "thresholds": [10, 50, 100, 250, 500, 1000, 2500, 5000, 10000], "unit": "count", "requires": "flashcards", "hanOnly": false, "source": "log"},
    {"family": "words-mature", "thresholds": [10, 50, 100, 250, 500, 1000, 2500, 5000], "unit": "count", "requires": "flashcards", "hanOnly": false, "source": "replay"},
    {"family": "characters-learned", "thresholds": [10, 50, 100, 250, 500, 1000, 2000, 3000, 5000], "unit": "count", "requires": "flashcards", "hanOnly": true, "source": "replay"},
    {"family": "streak", "thresholds": [3, 7, 14, 30, 60, 100, 180, 365, 500, 730, 1000], "unit": "days", "requires": "flashcards", "hanOnly": false, "source": "log"},
    {"family": "days-active", "thresholds": [10, 30, 50, 100, 200, 365, 500, 1000], "unit": "days", "requires": null, "hanOnly": false, "source": "log"},
    {"family": "reading-hours", "thresholds": [1, 5, 10, 25, 50, 100, 250, 500, 1000], "unit": "hours", "requires": "reader", "hanOnly": false, "source": "log"},
    {"family": "journal-entries", "thresholds": [1, 10, 25, 50, 100, 250, 365, 500], "unit": "count", "requires": "journal", "hanOnly": false, "source": "log"},
    {"family": "level-complete", "thresholds": [], "unit": "count", "requires": "flashcards", "hanOnly": false, "source": "replay"},
    {"family": "course-started", "thresholds": [], "unit": "count", "requires": "courses", "hanOnly": false, "source": "course"},
    {"family": "course-unit", "thresholds": [], "unit": "count", "requires": "courses", "hanOnly": false, "source": "course"},
    {"family": "course-section", "thresholds": [], "unit": "count", "requires": "courses", "hanOnly": false, "source": "course"},
    {"family": "course-script", "thresholds": [], "unit": "count", "requires": "courses", "hanOnly": false, "source": "course"},
    {"family": "course-characters", "thresholds": [100, 250, 500, 1000], "unit": "count", "requires": "courses", "hanOnly": false, "source": "course"},
    {"family": "course-words", "thresholds": [50, 100, 250, 500, 1000, 1500, 2000, 3000], "unit": "count", "requires": "courses", "hanOnly": false, "source": "course"},
    {"family": "course-graduated", "thresholds": [], "unit": "count", "requires": "courses", "hanOnly": false, "source": "course"}
  ],
  "titles": {"reviews": {"one": "{n} review", "other": "{n} reviews"}, "words-studied": {"one": "{n} word studied", "other": "{n} words studied"}, "words-mature": {"one": "{n} mature word", "other": "{n} mature words"}, "characters-learned": {"one": "{n} character learned", "other": "{n} characters learned"}, "streak": {"one": "{n}-day streak", "other": "{n}-day streak"}, "days-active": {"one": "{n} day active", "other": "{n} days active"}, "reading-hours": {"one": "{n} hour of reading", "other": "{n} hours of reading"}, "journal-entries": {"one": "{n} journal entry", "other": "{n} journal entries"}, "level-complete": {"one": "{level} complete", "other": "{level} complete"}, "course-started": {"one": "First course lesson", "other": "First course lesson"}, "course-unit": {"one": "Unit done: {unit}", "other": "Unit done: {unit}"}, "course-section": {"one": "Section done: {section}", "other": "Section done: {section}"}, "course-script": {"one": "{script} complete", "other": "{script} complete"}, "course-characters": {"one": "{n} course character", "other": "{n} course characters"}, "course-words": {"one": "{n} course word", "other": "{n} course words"}, "course-graduated": {"one": "Course complete: {course}", "other": "Course complete: {course}"}},
  "cases": [
    {"op": "id", "name": "a count id", "family": "reviews", "threshold": 1000, "expect": "reviews:1000"},
    {"op": "id", "name": "a streak id", "family": "streak", "threshold": 7, "expect": "streak:7"},
    {"op": "id", "name": "a level id is the level deck id", "family": "level-complete", "packId": "hsk-words", "level": "HSK 1", "expect": "level-complete:d-lvl-hsk-words-b06fd2ac"},
    {"op": "id", "name": "a level id of an odd pack name", "family": "level-complete", "packId": "My Pack_2", "level": "Ünï", "expect": "level-complete:d-lvl-my-pack-2-71cc27e0"},
    {"op": "id", "name": "a course unit", "family": "course-unit", "course": "zh-course", "part": "hsk1-hello", "expect": "course-unit:zh-course:hsk1-hello"},
    {"op": "id", "name": "course words", "family": "course-words", "course": "ja-course", "part": 250, "expect": "course-words:ja-course:250"},
    {"op": "id", "name": "the first lesson of a course", "family": "course-started", "course": "zh-course", "expect": "course-started:zh-course"},
    {"op": "parse", "name": "a threshold id", "id": "reviews:1000", "expect": {"family": "reviews", "threshold": 1000}},
    {"op": "parse", "name": "the first journal entry", "id": "journal-entries:1", "expect": {"family": "journal-entries", "threshold": 1}},
    {"op": "parse", "name": "a level id", "id": "level-complete:d-lvl-hsk-words-b06fd2ac", "expect": {"family": "level-complete", "deckId": "d-lvl-hsk-words-b06fd2ac"}},
    {"op": "parse", "name": "a leading zero is unknown", "id": "reviews:0100", "expect": null},
    {"op": "parse", "name": "a number that is not a threshold is unknown", "id": "reviews:7", "expect": null},
    {"op": "parse", "name": "an unknown family is unknown", "id": "nope:1", "expect": null},
    {"op": "parse", "name": "no threshold", "id": "reviews:", "expect": null},
    {"op": "parse", "name": "exponent notation", "id": "reviews:1e3", "expect": null},
    {"op": "parse", "name": "a plus sign", "id": "reviews:+100", "expect": null},
    {"op": "parse", "name": "case matters", "id": "Reviews:100", "expect": null},
    {"op": "parse", "name": "a row key is not an id", "id": "milestone:reviews:100", "expect": null},
    {"op": "parse", "name": "a level id that is not a level deck id", "id": "level-complete:HSK 1", "expect": null},
    {"op": "parse", "name": "an empty level id", "id": "level-complete:", "expect": null},
    {"op": "parse", "name": "a threshold appended later would parse; this one is not in the catalogue", "id": "streak:2", "expect": null},
    {"op": "parse", "name": "a course start", "id": "course-started:zh-course", "expect": {"family": "course-started", "course": "zh-course"}},
    {"op": "parse", "name": "graduation", "id": "course-graduated:ja-course", "expect": {"family": "course-graduated", "course": "ja-course"}},
    {"op": "parse", "name": "a course unit (parse)", "id": "course-unit:zh-course:hsk1-hello", "expect": {"family": "course-unit", "course": "zh-course", "part": "hsk1-hello"}},
    {"op": "parse", "name": "a course section", "id": "course-section:zh-course:hsk1", "expect": {"family": "course-section", "course": "zh-course", "part": "hsk1"}},
    {"op": "parse", "name": "a course script", "id": "course-script:ja-course:hiragana", "expect": {"family": "course-script", "course": "ja-course", "part": "hiragana"}},
    {"op": "parse", "name": "course characters", "id": "course-characters:zh-course:100", "expect": {"family": "course-characters", "course": "zh-course", "threshold": 100}},
    {"op": "parse", "name": "course words (parse)", "id": "course-words:zh-course:3000", "expect": {"family": "course-words", "course": "zh-course", "threshold": 3000}},
    {"op": "parse", "name": "course words that are not a threshold", "id": "course-words:zh-course:30", "expect": null},
    {"op": "parse", "name": "a course unit without a unit", "id": "course-unit:zh-course", "expect": null},
    {"op": "parse", "name": "a course unit id that is not an id", "id": "course-unit:zh-course:Hello World", "expect": null},
    {"op": "parse", "name": "a course start with a part", "id": "course-started:zh-course:x", "expect": null},
    {"op": "parse", "name": "a course id that is not a pack id", "id": "course-graduated:zh course", "expect": null},
    {"op": "parse", "name": "no course", "id": "course-section::hsk1", "expect": null},
    {"op": "enabled", "name": "everything on, Han", "switches": {"flashcards": true, "reader": true, "journal": true, "courses": true}, "han": true, "expect": ["reviews", "words-studied", "words-mature", "characters-learned", "streak", "days-active", "reading-hours", "journal-entries", "level-complete", "course-started", "course-unit", "course-section", "course-script", "course-characters", "course-words", "course-graduated"]},
    {"op": "enabled", "name": "everything on, not Han", "switches": {"flashcards": true, "reader": true, "journal": true, "courses": true}, "han": false, "expect": ["reviews", "words-studied", "words-mature", "streak", "days-active", "reading-hours", "journal-entries", "level-complete", "course-started", "course-unit", "course-section", "course-script", "course-characters", "course-words", "course-graduated"]},
    {"op": "enabled", "name": "flashcards off", "switches": {"flashcards": false, "reader": true, "journal": true, "courses": false}, "han": true, "expect": ["days-active", "reading-hours", "journal-entries"]},
    {"op": "enabled", "name": "only flashcards", "switches": {"flashcards": true, "reader": false, "journal": false, "courses": false}, "han": true, "expect": ["reviews", "words-studied", "words-mature", "characters-learned", "streak", "days-active", "level-complete"]},
    {"op": "enabled", "name": "everything off: days-active stays", "switches": {"flashcards": false, "reader": false, "journal": false, "courses": false}, "han": false, "expect": ["days-active"]},
    {"op": "enabled", "name": "only courses", "switches": {"flashcards": false, "reader": false, "journal": false, "courses": true}, "han": false, "expect": ["days-active", "course-started", "course-unit", "course-section", "course-script", "course-characters", "course-words", "course-graduated"]},
    {"op": "order", "name": "family order, then the higher threshold first, level ids by id", "ids": ["journal-entries:1", "level-complete:d-lvl-hsk-words-b06fd2ac", "streak:3", "reviews:100", "level-complete:d-lvl-hsk-words-19f1a7e4", "reviews:1000", "streak:30", "words-studied:10"], "expect": ["reviews:1000", "reviews:100", "words-studied:10", "streak:30", "streak:3", "journal-entries:1", "level-complete:d-lvl-hsk-words-19f1a7e4", "level-complete:d-lvl-hsk-words-b06fd2ac"]},
    {"op": "order", "name": "course families after the levels, in catalogue order, then the higher threshold first, else by id", "ids": ["course-graduated:zh-course", "course-words:zh-course:50", "course-unit:zh-course:hsk1-hello", "course-started:zh-course", "course-words:zh-course:100", "course-unit:zh-course:hsk1-family", "course-section:zh-course:hsk1", "course-script:ja-course:hiragana", "course-characters:zh-course:100", "level-complete:d-lvl-hsk-words-b06fd2ac", "reviews:100"], "expect": ["reviews:100", "level-complete:d-lvl-hsk-words-b06fd2ac", "course-started:zh-course", "course-unit:zh-course:hsk1-family", "course-unit:zh-course:hsk1-hello", "course-section:zh-course:hsk1", "course-script:ja-course:hiragana", "course-characters:zh-course:100", "course-words:zh-course:100", "course-words:zh-course:50", "course-graduated:zh-course"]},
    {"op": "title", "name": "grouped thousands", "id": "reviews:1000", "expect": "1,000 reviews"},
    {"op": "title", "name": "singular", "id": "journal-entries:1", "expect": "1 journal entry"},
    {"op": "title", "name": "singular hour", "id": "reading-hours:1", "expect": "1 hour of reading"},
    {"op": "title", "name": "streak", "id": "streak:365", "expect": "365-day streak"},
    {"op": "title", "name": "a level by its label", "id": "level-complete:d-lvl-hsk-words-b06fd2ac", "levels": {"d-lvl-hsk-words-b06fd2ac": "HSK Words · HSK 1"}, "expect": "HSK Words · HSK 1 complete"},
    {"op": "title", "name": "a level whose label is unknown", "id": "level-complete:d-lvl-hsk-words-b06fd2ac", "levels": {}, "expect": null},
    {"op": "title", "name": "an unknown id has no title", "id": "reviews:7", "expect": null},
    {"op": "title", "name": "the first course lesson", "id": "course-started:zh-course", "names": {"course:zh-course": "Chinese", "course:zh-course:unit:hsk1-hello": "Hello", "course:zh-course:section:hsk1": "≈ HSK 1", "script:hiragana": "Hiragana", "course:ja-course": "Japanese"}, "expect": "First course lesson"},
    {"op": "title", "name": "a course unit by its title", "id": "course-unit:zh-course:hsk1-hello", "names": {"course:zh-course": "Chinese", "course:zh-course:unit:hsk1-hello": "Hello", "course:zh-course:section:hsk1": "≈ HSK 1", "script:hiragana": "Hiragana", "course:ja-course": "Japanese"}, "expect": "Unit done: Hello"},
    {"op": "title", "name": "a course section by its title", "id": "course-section:zh-course:hsk1", "names": {"course:zh-course": "Chinese", "course:zh-course:unit:hsk1-hello": "Hello", "course:zh-course:section:hsk1": "≈ HSK 1", "script:hiragana": "Hiragana", "course:ja-course": "Japanese"}, "expect": "Section done: ≈ HSK 1"},
    {"op": "title", "name": "a script by its name", "id": "course-script:ja-course:hiragana", "names": {"course:zh-course": "Chinese", "course:zh-course:unit:hsk1-hello": "Hello", "course:zh-course:section:hsk1": "≈ HSK 1", "script:hiragana": "Hiragana", "course:ja-course": "Japanese"}, "expect": "Hiragana complete"},
    {"op": "title", "name": "course characters (title)", "id": "course-characters:zh-course:1000", "names": {"course:zh-course": "Chinese", "course:zh-course:unit:hsk1-hello": "Hello", "course:zh-course:section:hsk1": "≈ HSK 1", "script:hiragana": "Hiragana", "course:ja-course": "Japanese"}, "expect": "1,000 course characters"},
    {"op": "title", "name": "course words (title)", "id": "course-words:zh-course:50", "names": {"course:zh-course": "Chinese", "course:zh-course:unit:hsk1-hello": "Hello", "course:zh-course:section:hsk1": "≈ HSK 1", "script:hiragana": "Hiragana", "course:ja-course": "Japanese"}, "expect": "50 course words"},
    {"op": "title", "name": "graduation names the course", "id": "course-graduated:zh-course", "names": {"course:zh-course": "Chinese", "course:zh-course:unit:hsk1-hello": "Hello", "course:zh-course:section:hsk1": "≈ HSK 1", "script:hiragana": "Hiragana", "course:ja-course": "Japanese"}, "expect": "Course complete: Chinese"},
    {"op": "title", "name": "a course this client does not hold has no title", "id": "course-started:other-course", "names": {"course:zh-course": "Chinese", "course:zh-course:unit:hsk1-hello": "Hello", "course:zh-course:section:hsk1": "≈ HSK 1", "script:hiragana": "Hiragana", "course:ja-course": "Japanese"}, "expect": null},
    {"op": "title", "name": "a unit whose title is unknown has no title", "id": "course-unit:zh-course:hsk1-family", "names": {"course:zh-course": "Chinese", "course:zh-course:unit:hsk1-hello": "Hello", "course:zh-course:section:hsk1": "≈ HSK 1", "script:hiragana": "Hiragana", "course:ja-course": "Japanese"}, "expect": null}
  ],
  "titleNames": "title cases name the course's own words by key: course:<course> (its title), course:<course>:unit:<unit>, course:<course>:section:<section>, script:<script> (the script's interface name); level ids by their level deck id"
}
