{
  "version": 1,
  "rule": "i18n/invalid-messages",
  "note": "Messages outside the ICU subset of README.md: parsing fails with the error kind. Kinds: select (a select argument), argType (any other argument type: number, date, time, selectordinal, ...), exactMatch (=N in a plural), nestedPlural, partialPlural (text around a plural: the plural must be the whole message), missingOther, unknownCategory (not one of zero one two few many other), duplicateCategory, unbalanced (a stray { or }, an unclosed argument or branch), badArgName (not [a-z][a-zA-Z0-9]*), strayHash (# outside a plural branch), badTag (a < that does not open or close a valid tag, an unclosed or mismatched tag, attributes), nestedTag, tagInPlural (tags are not allowed in plural messages).",
  "cases": [
    {"name": "select", "message": "{g, select, male {He} other {They}}", "error": "select"},
    {"name": "number argument type", "message": "Total {n, number}", "error": "argType"},
    {"name": "date argument type", "message": "On {d, date, short}", "error": "argType"},
    {"name": "selectordinal", "message": "{n, selectordinal, one {#st} other {#th}}", "error": "argType"},
    {"name": "exact match", "message": "{n, plural, =0 {none} other {# items}}", "error": "exactMatch"},
    {"name": "nested plural", "message": "{n, plural, one {{m, plural, one {a} other {b}}} other {c}}", "error": "nestedPlural"},
    {"name": "text before a plural", "message": "You have {n, plural, one {# card} other {# cards}}", "error": "partialPlural"},
    {"name": "text after a plural", "message": "{n, plural, one {# card} other {# cards}} due", "error": "partialPlural"},
    {"name": "space around a plural", "message": " {n, plural, one {# card} other {# cards}}", "error": "partialPlural"},
    {"name": "missing other", "message": "{n, plural, one {# card}}", "error": "missingOther"},
    {"name": "unknown category", "message": "{n, plural, one {a} lots {b} other {c}}", "error": "unknownCategory"},
    {"name": "duplicate category", "message": "{n, plural, one {a} one {b} other {c}}", "error": "duplicateCategory"},
    {"name": "plural offset", "message": "{n, plural, offset:1 one {a} other {b}}", "error": "unknownCategory"},
    {"name": "stray opening brace", "message": "Use { to open", "error": "unbalanced"},
    {"name": "stray closing brace", "message": "Use } to close", "error": "unbalanced"},
    {"name": "unclosed argument", "message": "Hello {name", "error": "unbalanced"},
    {"name": "unclosed branch", "message": "{n, plural, one {a} other {b}", "error": "unbalanced"},
    {"name": "empty argument", "message": "Hello {}", "error": "badArgName"},
    {"name": "capitalised argument name", "message": "Hello {Name}", "error": "badArgName"},
    {"name": "digit argument name", "message": "Hello {0}", "error": "badArgName"},
    {"name": "underscore in argument name", "message": "Hello {first_name}", "error": "badArgName"},
    {"name": "spaces in an argument", "message": "Hello { name }", "error": "badArgName"},
    {"name": "hash outside a plural", "message": "Item #3", "error": "strayHash"},
    {"name": "stray less-than", "message": "a < b", "error": "badTag"},
    {"name": "unclosed tag", "message": "Read <link>this", "error": "badTag"},
    {"name": "mismatched tag", "message": "Read <link>this</b>", "error": "badTag"},
    {"name": "closing tag first", "message": "Read </link>", "error": "badTag"},
    {"name": "tag with an attribute", "message": "<a href=\"x\">link</a>", "error": "badTag"},
    {"name": "self-closing tag", "message": "Line<br/>break", "error": "badTag"},
    {"name": "capitalised tag", "message": "<Link>x</Link>", "error": "badTag"},
    {"name": "nested tags", "message": "<a>one <b>two</b></a>", "error": "nestedTag"},
    {"name": "tag in a plural", "message": "{n, plural, one {<b>#</b> card} other {<b>#</b> cards}}", "error": "tagInPlural"}
  ]
}
