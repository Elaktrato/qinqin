 "d": [
  {"i":3852,"keep":[3],"n":"寒さが厳しい/厳しい暑さ is very common and is taught with weather"},
  {"i":3857,"keep":[],"n":"'imagine' (夢を描く) is figurative and mostly 思い描く; the word is taught as drawing"},
  {"i":3860,"keep":[2],"n":"余裕がある/余裕の表情 for composure is common N3 and fits a moods unit"},
  {"i":3872,"keep":[2,5],"n":"scratches on objects (車に傷) and 心の傷 are common; 'flaw' is figurative and less frequent"},
  {"i":3888,"keep":[],"n":"'involve' is mostly 事故に巻き込まれる, not a relationships theme"},
  {"i":3890,"keep":[5,6],"n":"タクシーを拾う and picking someone up by car are common and belong to transport"},
  {"i":3904,"keep":[4],"n":"おにぎり/寿司を握る is a common food-related use"},
  {"i":3909,"keep":[4],"n":"彼女に振られた is very common and taught with dating"},
  {"i":3914,"keep":[],"n":"'phrase' (決まり文句) is less common at this level; the word is learned as 'complaint'"},
  {"i":3918,"keep":[2],"n":"hurting someone's feelings is a core common sense; the feelings unit is enough"},
  {"i":3920,"keep":[2],"n":"the star shape ★ is taught with shapes (丸・三角・星)"},
  {"i":3940,"keep":[4],"n":"この店では〜を扱っています is common N3 shop language"},
  {"i":3941,"keep":[],"n":"目が輝く for happiness is figurative"},
  {"i":3967,"keep":[],"n":"the black-market sense appears mainly in compounds (闇市, 闇バイト), not for the bare word at this level"},
  {"i":3977,"keep":[2,3],"n":"hurt feelings and damaged objects are both common uses outside health"},
  {"i":3984,"keep":[2,4],"n":"薄い色 and 味が薄い are everyday uses for colours and food"},
  {"i":3985,"keep":[],"n":"electrical resistance and resistors are technical, beyond learner level"},
  {"i":3994,"keep":[2],"n":"ご成功をお祈りします is a common wish/hope use"},
  {"i":3995,"keep":[],"n":"'ally, join hands' is political and figurative, not a relationships theme"}
