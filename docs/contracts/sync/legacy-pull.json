{
 "version": 1,
 "rule": "sync/legacy-pull",
 "_doc": "GET /api/sync/pull without v=2 (the legacy form, until v0.5.0): cursor and collections as in v0.3.x, one streamed JSON object with keys in this order. Each case runs on a fresh server for alice; setup names fixtures the test seeds (lexicon: a zh dictionary with entries, senses, links, a level scheme; packSentence: a pack sentence; ownSentence / otherUsersSentence: alice's / bob's sentence; typedCard: a live typed card; pluginRow / pluginTombstone: a live and a tombstoned qinqin-core row). expect: keys (exactly, in order), empty (keys whose arrays are []), typed (row counts), legacyRows (qinqin-flashcards rows in pluginData built from typed rows), sentences own (only alice's own), pluginData (setup names, in order), deprecation (Deprecation: true and Link: </api/sync/pull?v=2>; rel=\"successor-version\" headers), error (JSON {error, message}), text / textPrefix (plain-text body). Decoded by server/internal/sync contract_legacy_test.go (B4).",
 "headers": {
  "Deprecation": "true",
  "Link": "</api/sync/pull?v=2>; rel=\"successor-version\""
 },
 "keys": [
  "cursor",
  "entries",
  "links",
  "senses",
  "levelMembers",
  "sentences",
  "pluginData",
  "pluginStates",
  "overlays",
  "dictionaries",
  "schemes",
  "levels",
  "cards",
  "decks",
  "deckSettings",
  "limits",
  "fsrsSets",
  "fsrsActive"
 ],
 "moved": [
  "entries",
  "links",
  "senses",
  "levelMembers",
  "dictionaries",
  "schemes",
  "levels"
 ],
 "cases": [
  {
   "name": "no collections: every key, lexicon keys empty, typed collections, no legacy rows in pluginData",
   "query": {},
   "setup": [
    "lexicon",
    "packSentence",
    "ownSentence",
    "typedCard",
    "pluginRow"
   ],
   "expect": {
    "status": 200,
    "keys": [
     "cursor",
     "entries",
     "links",
     "senses",
     "levelMembers",
     "sentences",
     "pluginData",
     "pluginStates",
     "overlays",
     "dictionaries",
     "schemes",
     "levels",
     "cards",
     "decks",
     "deckSettings",
     "limits",
     "fsrsSets",
     "fsrsActive"
    ],
    "empty": [
     "entries",
     "links",
     "senses",
     "levelMembers",
     "dictionaries",
     "schemes",
     "levels"
    ],
    "typed": {
     "cards": 1
    },
    "legacyRows": 0,
    "sentences": "own",
    "deprecation": true
   }
  },
  {
   "name": "collections=pluginData,pluginStates (a v0.3.x shell): typed rows appended to pluginData as legacy rows",
   "query": {
    "cursor": "1970-01-01T00:00:00Z",
    "collections": "pluginData,pluginStates"
   },
   "setup": [
    "typedCard",
    "pluginRow"
   ],
   "expect": {
    "status": 200,
    "keys": [
     "cursor",
     "entries",
     "links",
     "senses",
     "levelMembers",
     "sentences",
     "pluginData",
     "pluginStates",
     "overlays",
     "dictionaries",
     "schemes",
     "levels",
     "cards",
     "decks",
     "deckSettings",
     "limits",
     "fsrsSets",
     "fsrsActive"
    ],
    "empty": [
     "entries",
     "links",
     "senses",
     "levelMembers",
     "sentences",
     "overlays",
     "dictionaries",
     "schemes",
     "levels",
     "cards",
     "decks",
     "deckSettings",
     "limits",
     "fsrsSets",
     "fsrsActive"
    ],
    "legacyRows": 1,
    "legacyView": "docs/contracts/study/legacy-view.json",
    "deprecation": true
   }
  },
  {
   "name": "the item-4 web's pull (typed collections named): no legacy rows",
   "query": {
    "cursor": "1970-01-01T00:00:00Z",
    "collections": "pluginData,pluginStates,cards,decks,deckSettings,limits,fsrsSets,fsrsActive"
   },
   "setup": [
    "typedCard",
    "pluginRow"
   ],
   "expect": {
    "status": 200,
    "keys": [
     "cursor",
     "entries",
     "links",
     "senses",
     "levelMembers",
     "sentences",
     "pluginData",
     "pluginStates",
     "overlays",
     "dictionaries",
     "schemes",
     "levels",
     "cards",
     "decks",
     "deckSettings",
     "limits",
     "fsrsSets",
     "fsrsActive"
    ],
    "typed": {
     "cards": 1
    },
    "legacyRows": 0,
    "deprecation": true
   }
  },
  {
   "name": "sentences carries own sentences only",
   "query": {
    "collections": "sentences"
   },
   "setup": [
    "lexicon",
    "packSentence",
    "ownSentence",
    "otherUsersSentence"
   ],
   "expect": {
    "status": 200,
    "keys": [
     "cursor",
     "entries",
     "links",
     "senses",
     "levelMembers",
     "sentences",
     "pluginData",
     "pluginStates",
     "overlays",
     "dictionaries",
     "schemes",
     "levels",
     "cards",
     "decks",
     "deckSettings",
     "limits",
     "fsrsSets",
     "fsrsActive"
    ],
    "sentences": "own",
    "deprecation": true
   }
  },
  {
   "name": "no cursor ships live rows only; the 1970 cursor ships tombstones",
   "query": {
    "collections": "pluginData"
   },
   "setup": [
    "pluginRow",
    "pluginTombstone"
   ],
   "expect": {
    "status": 200,
    "pluginData": [
     "live"
    ],
    "deprecation": true
   },
   "then": {
    "query": {
     "cursor": "1970-01-01T00:00:00Z",
     "collections": "pluginData"
    },
    "expect": {
     "status": 200,
     "pluginData": [
      "live",
      "tombstone"
     ]
    }
   }
  },
  {
   "name": "the answer cursor is the server clock minus 30 s",
   "query": {
    "collections": "pluginStates"
   },
   "now": "2026-11-12T10:00:00Z",
   "expect": {
    "status": 200,
    "cursor": "2026-11-12T09:59:30Z"
   }
  },
  {
   "name": "naming entries is 400 sync_collection_moved (JSON)",
   "query": {
    "collections": "pluginData,entries"
   },
   "expect": {
    "status": 400,
    "error": "sync_collection_moved",
    "messageContains": "/api/packages"
   }
  },
  {
   "name": "naming links is 400 sync_collection_moved (JSON)",
   "query": {
    "collections": "pluginData,links"
   },
   "expect": {
    "status": 400,
    "error": "sync_collection_moved",
    "messageContains": "/api/packages"
   }
  },
  {
   "name": "naming senses is 400 sync_collection_moved (JSON)",
   "query": {
    "collections": "pluginData,senses"
   },
   "expect": {
    "status": 400,
    "error": "sync_collection_moved",
    "messageContains": "/api/packages"
   }
  },
  {
   "name": "naming levelMembers is 400 sync_collection_moved (JSON)",
   "query": {
    "collections": "pluginData,levelMembers"
   },
   "expect": {
    "status": 400,
    "error": "sync_collection_moved",
    "messageContains": "/api/packages"
   }
  },
  {
   "name": "naming dictionaries is 400 sync_collection_moved (JSON)",
   "query": {
    "collections": "pluginData,dictionaries"
   },
   "expect": {
    "status": 400,
    "error": "sync_collection_moved",
    "messageContains": "/api/packages"
   }
  },
  {
   "name": "naming schemes is 400 sync_collection_moved (JSON)",
   "query": {
    "collections": "pluginData,schemes"
   },
   "expect": {
    "status": 400,
    "error": "sync_collection_moved",
    "messageContains": "/api/packages"
   }
  },
  {
   "name": "naming levels is 400 sync_collection_moved (JSON)",
   "query": {
    "collections": "pluginData,levels"
   },
   "expect": {
    "status": 400,
    "error": "sync_collection_moved",
    "messageContains": "/api/packages"
   }
  },
  {
   "name": "an unknown collection stays a plain-text 400",
   "query": {
    "collections": "pluginData,flashcards"
   },
   "expect": {
    "status": 400,
    "textPrefix": "sync: invalid: unknown collection"
   }
  },
  {
   "name": "a cursor that is not RFC 3339 stays a plain-text 400",
   "query": {
    "cursor": "yesterday"
   },
   "expect": {
    "status": 400,
    "text": "cursor must be RFC 3339"
   }
  },
  {
   "name": "no session is 401",
   "as": "",
   "query": {},
   "expect": {
    "status": 401
   }
  }
 ]
}
