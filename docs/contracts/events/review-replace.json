{
  "version": 1,
  "rule": "events/review-replace",
  "note": "Over the review events a client holds: a valid review E links to T when E.payload.replaces equals T.id (T.id != E.id), both are valid reviews (review-parse.json) of the same workspace and cardId, and their instants fall in the same whole second. Links join reviews into families (connected components); in each family only the greatest id (plain string comparison) counts, every other member is replaced and counts nowhere. live: the ids that count, in (instant, id) order; replaced: the replaced ids, sorted.",
  "cases": [
    {
      "name": "a misclick replaced by the intended grade",
      "note": "Again, then Good replacing it with the same ts: only Good counts; another card is unaffected",
      "events": [
        {
          "id": "01KAPZ00000000000000000001",
          "workspaceId": 7,
          "device": "web",
          "ts": "2026-11-22T09:00:00Z",
          "type": "review",
          "payload": {
            "cardId": "c1",
            "mode": "vocab",
            "grade": 1
          }
        },
        {
          "id": "01KAPZ00000000000000000002",
          "workspaceId": 7,
          "device": "web",
          "ts": "2026-11-22T09:00:00Z",
          "type": "review",
          "payload": {
            "cardId": "c1",
            "mode": "vocab",
            "grade": 3,
            "replaces": "01KAPZ00000000000000000001"
          }
        },
        {
          "id": "01KAPZ00000000000000000003",
          "workspaceId": 7,
          "device": "web",
          "ts": "2026-11-22T09:00:05Z",
          "type": "review",
          "payload": {
            "cardId": "c2",
            "mode": "vocab",
            "grade": 3
          }
        }
      ],
      "live": [
        "01KAPZ00000000000000000002",
        "01KAPZ00000000000000000003"
      ],
      "replaced": [
        "01KAPZ00000000000000000001"
      ]
    },
