{
  "version": 1,
  "rule": "milestones/seen-merge",
  "note": "union: pushes applied in order to one server under the plugin-data LWW (a pushed row older than the stored one is skipped); seen: the live keys afterwards. writePlan: the rows a dismiss writes (mark = the covered milestones, live = the pulled rows, tombstones included); knownAt = the tombstone's newest stamp, the push stamps the row after it (as known marks do). seen: live rows union pending. push: the push answer and whether the ids stay pending (done = every row accepted). prune: the pending list after a pull.",
  "cases": [
    {"op": "union", "name": "two devices writing different keys: both stay", "note": "LWW per key (overview, Sync model): different keys never conflict", "pushes": [{"device": "phone", "key": "milestone:reviews:100", "updatedAt": "2026-11-17T08:00:00.000Z"}, {"device": "laptop", "key": "milestone:streak:7", "updatedAt": "2026-11-17T07:00:00.000Z"}], "expect": {"results": ["accepted", "accepted"], "seen": ["reviews:100", "streak:7"]}},
    {"op": "union", "name": "the same key twice: the older push is skipped, the key stays seen", "pushes": [{"device": "phone", "key": "milestone:reviews:100", "updatedAt": "2026-11-17T08:00:00.000Z"}, {"device": "laptop", "key": "milestone:reviews:100", "updatedAt": "2026-11-17T07:59:00.000Z"}], "expect": {"results": ["accepted", "skipped"], "seen": ["reviews:100"]}},
    {"op": "union", "name": "the same key twice, the later push newer: written again, still seen", "pushes": [{"device": "phone", "key": "milestone:reviews:100", "updatedAt": "2026-11-17T08:00:00.000Z"}, {"device": "laptop", "key": "milestone:reviews:100", "updatedAt": "2026-11-17T09:00:00.000Z"}], "expect": {"results": ["accepted", "accepted"], "seen": ["reviews:100"]}},
    {"op": "writePlan", "name": "only ids without a live row are written, never a tombstone; a tombstoned key is stamped after its tombstone", "now": "2026-11-17T08:00:00.000Z", "mark": [{"id": "reviews:100", "reachedAt": "2026-11-03T09:00:00Z", "reachedDay": "2026-11-03"}, {"id": "streak:7", "reachedAt": "2026-11-10T09:00:00Z", "reachedDay": "2026-11-10"}, {"id": "streak:7", "reachedAt": "2026-11-10T09:00:00Z", "reachedDay": "2026-11-10"}, {"id": "streak:3", "reachedAt": "2026-11-06T09:00:00Z", "reachedDay": "2026-11-06"}], "live": [{"key": "milestone:reviews:100", "data": {"version": 2}, "deletedAt": null}, {"key": "milestone:streak:3", "data": {"version": 1, "id": "streak:3", "seenAt": "2026-11-17T08:00:00.000Z", "reachedDay": "2026-11-06"}, "deletedAt": "2026-11-16T00:00:00Z"}], "expect": [{"key": "milestone:streak:7", "data": {"version": 1, "id": "streak:7", "seenAt": "2026-11-17T08:00:00.000Z", "reachedDay": "2026-11-10"}}, {"key": "milestone:streak:3", "data": {"version": 1, "id": "streak:3", "seenAt": "2026-11-17T08:00:00.000Z", "reachedDay": "2026-11-06"}, "knownAt": "2026-11-16T00:00:00Z"}]},
    {"op": "writePlan", "name": "everything already live: nothing to write", "now": "2026-11-17T08:00:00.000Z", "mark": [{"id": "reviews:100", "reachedAt": "2026-11-03T09:00:00Z", "reachedDay": "2026-11-03"}], "live": [{"key": "milestone:reviews:100", "data": {"version": 1, "id": "reviews:100", "seenAt": "2026-11-17T08:00:00.000Z", "reachedDay": "2026-11-03"}, "deletedAt": null}], "expect": []},
    {"op": "seen", "name": "seen = live rows plus the pending list", "live": [{"key": "milestone:reviews:100", "data": {"version": 1, "id": "reviews:100", "seenAt": "2026-11-17T08:00:00.000Z", "reachedDay": "2026-11-03"}, "deletedAt": null}, {"key": "milestone:streak:3", "data": {}, "deletedAt": "2026-11-16T00:00:00Z"}], "pending": [{"id": "streak:7", "seenAt": "2026-11-17T08:00:00.000Z", "reachedDay": "2026-11-10"}, {"id": "reviews:100", "seenAt": "2026-11-17T08:00:00.000Z", "reachedDay": "2026-11-03"}], "expect": ["reviews:100", "streak:7"]},
    {"op": "push", "name": "every row accepted: seen everywhere, the pending ids leave", "answer": {"dataAccepted": 2, "dataSkipped": 0, "dataRefused": 0}, "expect": "done"},
    {"op": "push", "name": "a skipped row (the server holds a newer row for the key, e.g. a tombstone this client has not pulled): kept pending until the row is live in a pull", "answer": {"dataAccepted": 1, "dataSkipped": 1, "dataRefused": 0}, "expect": "pending"},
    {"op": "push", "name": "a refused row: kept pending (still seen here), retried with the next flush", "answer": {"dataAccepted": 0, "dataSkipped": 0, "dataRefused": 1}, "expect": "pending"},
    {"op": "push", "name": "a failed request (offline, 5xx): the ids stay pending", "answer": "network", "expect": "pending"},
    {"op": "prune", "name": "a pending id leaves once its row is live in a pull", "pending": [{"id": "streak:7", "seenAt": "2026-11-17T08:00:00.000Z", "reachedDay": "2026-11-10"}, {"id": "reviews:100", "seenAt": "2026-11-17T08:00:00.000Z", "reachedDay": "2026-11-03"}], "live": [{"key": "milestone:reviews:100", "data": {"version": 1, "id": "reviews:100", "seenAt": "2026-11-17T08:00:00.000Z", "reachedDay": "2026-11-03"}, "deletedAt": null}, {"key": "milestone:streak:7", "data": {}, "deletedAt": "2026-11-16T00:00:00Z"}], "expect": ["streak:7"]}
  ]
}
