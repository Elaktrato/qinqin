{
  "version": 1,
  "rule": "notes/text",
  "maxChars": 2000,
  "_doc": "Normalising and the cap of note text on save (docs/contracts/notes/README.md). input raw text -> expect {kind:'put', text} | {kind:'delete'} | {kind:'tooLong', chars}. Web: lib/notes/notes.test.ts.",
  "cases": [
    {
      "name": "CRLF becomes LF",
      "input": "a\r\nb",
      "expect": {
        "kind": "put",
        "text": "a\nb"
      }
    },
    {
      "name": "lone CR becomes LF",
      "input": "a\rb\r\rc",
      "expect": {
        "kind": "put",
        "text": "a\nb\n\nc"
      }
    },
    {
      "name": "trailing spaces and newlines are trimmed, leading kept",
      "input": "  lead\n text  \n\n \t",
      "expect": {
        "kind": "put",
        "text": "  lead\n text"
      }
    },
    {
      "name": "trailing ideographic space is trimmed",
      "input": "马　",
      "expect": {
        "kind": "put",
        "text": "马"
      }
    },
    {
      "name": "inner blank lines are kept",
      "input": "one\n\n\ntwo",
      "expect": {
        "kind": "put",
        "text": "one\n\n\ntwo"
      }
    },
    {
      "name": "empty is a delete",
      "input": "",
      "expect": {
        "kind": "delete"
      }
    },
    {
      "name": "blank is a delete",
      "input": " \r\n\t \n",
      "expect": {
        "kind": "delete"
      }
    },
