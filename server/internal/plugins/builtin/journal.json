{
	"id": "qinqin-journal",
	"name": "Journal",
	"version": "1.1",
	"type": "feature",
	"sdk": 1,
	"description": "Dated entries in your target language, with AI feedback.",
	"surfaces": ["page"],
	"permissions": ["owns-data", "write:study-events"],
	"hooks": [],
	"events": [{ "type": "journal", "activity": { "label": "Journal entries", "describe": { "one": "{n} journal entry", "other": "{n} journal entries" }, "distinctBy": "entryId" } }]
}
