{
 "version": 1,
 "rule": "grammar/runs",
 "note": "A finished grammar lesson run is a `grammar` study event (#277). Progress is replayed from the events; old progress rows (migration 056) and old backup rows become one event each.",
 "constants": {
  "maxExercises": 1000,
  "lessonRunXp": 20
 },
 "build": [
  {
   "name": "a run names the point, the mode, the score and the total, in this member order",
   "args": [
    "zh-grammar",
    "le-change",
    3,
    4
   ],
   "expect": {
    "point": "zh-grammar:le-change",
    "mode": "lesson",
    "score": 3,
    "total": 4
   }
  }
 ],
 "parse": [
  {
   "name": "a lesson run",
   "event": {
    "id": "01KA00000000000000000000G1",
    "workspaceId": 7,
    "device": "web",
    "ts": "2026-11-19T08:00:00Z",
    "type": "grammar",
    "payload": {
     "point": "zh-grammar:le-change",
     "mode": "lesson",
     "score": 3,
     "total": 4
    }
   },
   "expect": {
    "packId": "zh-grammar",
    "lessonId": "le-change",
    "point": "zh-grammar:le-change",
    "mode": "lesson",
    "score": 3,
    "total": 4
   }
  },
  {
   "name": "a pack id with dots and capitals",
   "event": {
    "id": "01KA00000000000000000000G2",
    "workspaceId": 7,
    "device": "web",
    "ts": "2026-11-19T08:00:00Z",
    "type": "grammar",
    "payload": {
     "point": "My.Pack_2:ba",
     "mode": "lesson",
     "score": 0,
     "total": 0
    }
   },
   "expect": {
    "packId": "My.Pack_2",
    "lessonId": "ba",
    "point": "My.Pack_2:ba",
    "mode": "lesson",
    "score": 0,
    "total": 0
   }
  },
  {
   "name": "another type is no run",
   "event": {
    "id": "01KA00000000000000000000G3",
    "workspaceId": 7,
    "device": "web",
    "ts": "2026-11-19T08:00:00Z",
    "type": "review",
    "payload": {
     "point": "p:l",
     "mode": "lesson",
     "score": 1,
     "total": 1
    }
   },
   "expect": null
  },
  {
   "name": "an unknown mode is ignored",
   "event": {
    "id": "01KA00000000000000000000G4",
    "workspaceId": 7,
    "device": "web",
    "ts": "2026-11-19T08:00:00Z",
    "type": "grammar",
    "payload": {
     "point": "p:l",
     "mode": "review",
     "score": 1,
     "total": 1
    }
   },
   "expect": null
  },
  {
   "name": "no mode is no run",
   "event": {
    "id": "01KA00000000000000000000G5",
    "workspaceId": 7,
    "device": "web",
    "ts": "2026-11-19T08:00:00Z",
    "type": "grammar",
    "payload": {
     "point": "p:l",
     "score": 1,
     "total": 1
    }
   },
   "expect": null
  },
  {
   "name": "a score above the total",
