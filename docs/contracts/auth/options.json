{
  "_doc": "GET /api/auth/options is public and never cached. Read it before showing sign-in or register. passwordReset, emailCodeLogin and mfaEnforced are the EFFECTIVE values: false while no mail server is configured. totpAvailable is false when the server has no usable QINQIN_SECRET: hide the authenticator option and say why.",
  "closed": {
    "request": {"method": "GET", "path": "/api/auth/options"},
    "status": 200,
    "body": {"registration": "closed", "emailPolicy": "off", "passwordReset": false, "emailCodeLogin": false, "passwordMinLength": 10, "totpAvailable": false, "mfaEnforced": false}
  },
  "invite": {
    "request": {"method": "GET", "path": "/api/auth/options"},
    "status": 200,
    "body": {"registration": "invite", "emailPolicy": "optional", "passwordReset": false, "emailCodeLogin": false, "passwordMinLength": 10, "totpAvailable": false, "mfaEnforced": false}
  },
  "open": {
    "request": {"method": "GET", "path": "/api/auth/options"},
    "status": 200,
    "body": {"registration": "open", "emailPolicy": "required", "passwordReset": false, "emailCodeLogin": false, "passwordMinLength": 10, "totpAvailable": false, "mfaEnforced": false}
  }
}
