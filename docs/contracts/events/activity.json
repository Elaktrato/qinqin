{
 "version": 1,
 "rule": "events/activity",
 "note": "cells of GET /api/stats/activity for the built-in activity rules (rules lists them as the manifests declare them); events default to workspace 1",
 "rules": [
  {
   "type": "review",
   "rule": {
    "label": "Flashcard reviews",
    "describe": {
     "one": "{n} flashcard review",
     "other": "{n} flashcard reviews"
    }
   }
  },
  {
   "type": "read",
   "rule": {
    "label": "Reading",
    "describe": {
     "one": "{n} minute of reading",
     "other": "{n} minutes of reading"
    },
    "measure": {
     "field": "seconds",
     "unit": "seconds",
     "min": 30,
     "max": 7200
    },
    "pointsPer": 300
   }
  },
  {
   "type": "journal",
   "rule": {
    "label": "Journal entries",
    "describe": {
     "one": "{n} journal entry",
     "other": "{n} journal entries"
    },
    "distinctBy": "entryId"
   }
  }
 ],
 "cases": [
  {
   "name": "read: under 30 s scores nothing",
   "note": "a measure below min (30 s) is dropped",
   "history": [],
   "from": "2026-11-01",
   "to": "2026-11-03",
   "events": [
    {
     "payload": {
      "bookId": 1,
      "seconds": 29
     },
     "ts": "2026-11-01T10:00:00Z",
     "type": "read"
    }
   ],
   "cells": []
  },
  {
   "name": "read: 30 s is one point",
   "note": "points = ceil(seconds / 300) per event; raw is the seconds",
   "history": [],
   "from": "2026-11-01",
   "to": "2026-11-03",
   "events": [
    {
     "payload": {
      "bookId": 1,
      "seconds": 30
     },
     "ts": "2026-11-01T10:00:00Z",
     "type": "read"
    }
   ],
   "cells": [
    {
     "day": "2026-11-01",
     "workspace": 1,
     "type": "read",
     "points": 1,
     "raw": 30
    }
   ]
  },
  {
   "name": "read: 300 s is one point, 301 s two",
   "note": "ceil, not round: a started 5 minutes counts",
   "history": [],
   "from": "2026-11-01",
   "to": "2026-11-03",
   "events": [
    {
     "payload": {
      "bookId": 1,
      "seconds": 300
     },
     "ts": "2026-11-01T10:00:00Z",
     "type": "read"
    },
    {
     "payload": {
      "bookId": 1,
      "seconds": 301
     },
     "ts": "2026-11-02T10:00:00Z",
     "type": "read"
    }
   ],
   "cells": [
    {
     "day": "2026-11-01",
     "workspace": 1,
     "type": "read",
     "points": 1,
     "raw": 300
    },
    {
     "day": "2026-11-02",
     "workspace": 1,
     "type": "read",
     "points": 2,
     "raw": 301
    }
   ]
  },
  {
   "name": "read: capped at 7200 s (24 points) per event",
   "note": "seconds above max count as max (raw too)",
   "history": [],
   "from": "2026-11-01",
   "to": "2026-11-03",
   "events": [
    {
     "payload": {
      "bookId": 1,
      "seconds": 7200
     },
     "ts": "2026-11-01T10:00:00Z",
     "type": "read"
    },
    {
     "payload": {
      "bookId": 1,
      "seconds": 7201
     },
     "ts": "2026-11-02T10:00:00Z",
     "type": "read"
    }
   ],
   "cells": [
    {
     "day": "2026-11-01",
     "workspace": 1,
     "type": "read",
     "points": 24,
     "raw": 7200
    },
    {
     "day": "2026-11-02",
     "workspace": 1,
     "type": "read",
     "points": 24,
     "raw": 7200
    }
   ]
  },
  {
   "name": "read: points are summed per event, not computed from the day's total",
   "note": "two events of 200 s are 2 points (raw 400); one event of 400 s would also be 2, three of 100 s are 3",
   "history": [],
   "from": "2026-11-01",
   "to": "2026-11-03",
   "events": [
    {
     "payload": {
      "bookId": 1,
      "seconds": 200
     },
     "ts": "2026-11-01T10:00:00Z",
     "type": "read"
    },
    {
     "payload": {
      "bookId": 2,
      "seconds": 200
     },
     "ts": "2026-11-01T11:00:00Z",
     "type": "read"
    },
    {
     "payload": {
      "seconds": 100
     },
     "ts": "2026-11-02T10:00:00Z",
     "type": "read"
    },
    {
     "payload": {
      "seconds": 100
     },
     "ts": "2026-11-02T11:00:00Z",
     "type": "read"
    },
    {
     "payload": {
      "seconds": 100
     },
     "ts": "2026-11-02T12:00:00Z",
     "type": "read"
    }
   ],
   "cells": [
    {
     "day": "2026-11-01",
     "workspace": 1,
     "type": "read",
     "points": 2,
     "raw": 400
    },
    {
     "day": "2026-11-02",
     "workspace": 1,
     "type": "read",
     "points": 3,
     "raw": 300
    }
   ]
  },
  {
   "name": "read: a real number counts, a string or a missing field does not",
   "note": "the field must be a JSON number (integer or real); a read without bookId still counts",
   "history": [],
   "from": "2026-11-01",
   "to": "2026-11-04",
   "events": [
    {
     "payload": {
      "seconds": 30.5
     },
     "ts": "2026-11-01T10:00:00Z",
     "type": "read"
    },
    {
     "payload": {
      "bookId": 1,
      "seconds": "600"
     },
     "ts": "2026-11-02T10:00:00Z",
     "type": "read"
    },
    {
     "payload": {
      "bookId": 1
     },
     "ts": "2026-11-03T10:00:00Z",
     "type": "read"
    },
    {
     "payload": null,
     "ts": "2026-11-03T11:00:00Z",
     "type": "read"
    }
   ],
   "cells": [
    {
     "day": "2026-11-01",
     "workspace": 1,
     "type": "read",
     "points": 1,
     "raw": 30.5
    }
   ]
  },
  {
   "name": "journal: one entry edited twice in a day counts once",
   "note": "distinctBy entryId: distinct string values per learner day and workspace",
   "history": [],
   "from": "2026-11-01",
   "to": "2026-11-03",
   "events": [
