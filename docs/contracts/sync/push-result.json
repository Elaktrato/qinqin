     "eventsAccepted": 1,
     "eventDuplicates": 1,
     "dataAccepted": 0,
     "dataSkipped": 0,
     "dataRefused": 0
    }
   }
  },
  {
   "name": "an older edit than the stored row is skipped (last-write-wins on the edit time)",
   "setup": {
    "pluginData": [
     {
      "pluginId": "qinqin-core",
      "key": "notecfg",
      "workspaceId": "$ws",
      "data": {
       "v": 2
      },
      "updatedAt": "2026-11-12T10:00:00Z"
     }
    ]
   },
   "body": {
    "pluginData": [
     {
      "pluginId": "qinqin-core",
      "key": "notecfg",
      "workspaceId": "$ws",
      "data": {
       "v": 1
      },
      "updatedAt": "2026-11-12T09:00:00Z"
