  {
   "kind": "server",
   "name": "a failed build keeps the previous revision ready and records the error",
   "steps": [
    {
     "do": {
      "op": "import",
      "type": "dictionary",
      "pack": "cedict",
      "language": "zh",
      "data": "v1"
     },
     "expect": [
      {
       "id": "lexicon.zh",
       "state": "ready",
       "revision": 1,
       "hash": "A"
      }
     ]
    },
    {
     "do": {
      "op": "import",
      "type": "dictionary",
      "pack": "cedict",
      "language": "zh",
      "data": "v2",
      "failBuild": true
     },
     "expect": [
      {
       "id": "lexicon.zh",
       "state": "ready",
       "revision": 1,
       "hash": "A",
       "error": true
      }
     ]
    },
    {
     "do": {
      "op": "reconcile"
     },
     "expect": [
      {
       "id": "lexicon.zh",
       "state": "ready",
       "revision": 2,
       "hash": "B",
       "error": false
      }
     ]
    }
   ]
  },
