# workspaces and languages

## list and defaults
bob defaults: GET /api/workspaces -> 200 [application/json] [{"id":1,"language":"es","name":"","settings":{},"updatedAt":"<ts>"}]
admin defaults: GET /api/workspaces -> 200 [application/json] [{"id":2,"language":"es","name":"","settings":{},"updatedAt":"<ts>"}]
anonymous: GET /api/workspaces -> 401 [application/json] {"error":"unauthorized","message":"Sign in to continue."}
languages: GET /api/languages -> 200 [application/json] [{"code":"es","name":"Spanish","installed":true,"kind":"data"},{"code":"ja","name":"ja","installed":false,"kind":"code"},{"code":"zh","name":"zh","installed":false,"kind":"code"}]

## create
malformed: POST /api/workspaces -> 400 [application/json] {"error":"bad_request","message":"Malformed request body."}
no language: POST /api/workspaces -> 400 [application/json] {"error":"bad_request","message":"language is required."}
long name: POST /api/workspaces -> 422 [application/json] {"error":"invalid_request","message":"name is longer than 40 characters"}
invisible name: POST /api/workspaces -> 422 [application/json] {"error":"invalid_request","message":"name contains control or invisible characters"}
tab name: POST /api/workspaces -> 422 [application/json] {"error":"invalid_request","message":"name contains control or invisible characters"}
zwj name: POST /api/workspaces -> 201 [application/json] {"id":3,"language":"zh","name":"a‍b","settings":{},"updatedAt":"<ts>"}
bad code: POST /api/workspaces -> 422 [application/json] {"error":"invalid_language","message":"language must be a code like es or pt-br."}
unknown language as user: POST /api/workspaces -> 422 [application/json] {"error":"language_unknown","message":"This language is not set up on the server: ask an administrator to add it."}
unknown language as admin: POST /api/workspaces -> 201 [application/json] {"id":4,"language":"ko","name":"","settings":{},"updatedAt":"<ts>"}
now known: POST /api/workspaces -> 201 [application/json] {"id":5,"language":"ko","name":"Mine","settings":{},"updatedAt":"<ts>"}
trimmed: POST /api/workspaces -> 201 [application/json] {"id":6,"language":"zh","name":"Main","settings":{},"updatedAt":"<ts>"}
taken: POST /api/workspaces -> 409 [application/json] {"error":"workspace_exists","message":"A workspace with this name already exists."}
second: POST /api/workspaces -> 201 [application/json] {"id":7,"language":"zh","name":"Other","settings":{},"updatedAt":"<ts>"}
underscore code: POST /api/workspaces -> 201 [application/json] {"id":8,"language":"pt-br","name":"","settings":{},"updatedAt":"<ts>"}
anonymous: POST /api/workspaces -> 401 [application/json] {"error":"unauthorized","message":"Sign in to continue."}
bob list: GET /api/workspaces -> 200 [application/json] [{"id":1,"language":"es","name":"","settings":{},"updatedAt":"<ts>"},{"id":3,"language":"zh","name":"a‍b","settings":{},"updatedAt":"<ts>"},{"id":5,"language":"ko","name":"Mine","settings":{},"updatedAt":"<ts>"},{"id":6,"language":"zh","name":"Main","settings":{},"updatedAt":"<ts>"},{"id":7,"language":"zh","name":"Other","settings":{},"updatedAt":"<ts>"}]

## update
not a number: PUT /api/workspaces/abc -> 404 [application/json] {"error":"workspace_not_found","message":"No such workspace."}
foreign: PUT /api/workspaces/2 -> 404 [application/json] {"error":"workspace_not_found","message":"No such workspace."}
unknown: PUT /api/workspaces/999 -> 404 [application/json] {"error":"workspace_not_found","message":"No such workspace."}
empty: PUT /api/workspaces/5 -> 400 [application/json] {"error":"bad_request","message":"name or settings required."}
unknown key: PUT /api/workspaces/5 -> 400 [application/json] {"error":"bad_request","message":"Malformed request body."}
malformed: PUT /api/workspaces/5 -> 400 [application/json] {"error":"bad_request","message":"Malformed request body."}
settings array: PUT /api/workspaces/5 -> 400 [application/json] {"error":"bad_request","message":"settings must be an object."}
settings null: PUT /api/workspaces/5 -> 400 [application/json] {"error":"bad_request","message":"name or settings required."}
long name: PUT /api/workspaces/5 -> 422 [application/json] {"error":"invalid_request","message":"name is longer than 40 characters"}
bad name before bad settings: PUT /api/workspaces/5 -> 422 [application/json] {"error":"invalid_request","message":"name contains control or invisible characters"}
settings: PUT /api/workspaces/5 -> 200 [application/json] {"id":5,"language":"ko","name":"Mine","settings":{"a":"1","b":{"c":2}},"updatedAt":"<ts>"}
settings merge: PUT /api/workspaces/5 -> 200 [application/json] {"id":5,"language":"ko","name":"Mine","settings":{"b":{"c":2,"d":3}},"updatedAt":"<ts>"}
rename: PUT /api/workspaces/6 -> 200 [application/json] {"id":6,"language":"zh","name":"Renamed","settings":{},"updatedAt":"<ts>"}
rename taken: PUT /api/workspaces/7 -> 409 [application/json] {"error":"workspace_exists","message":"A workspace with this name already exists."}
rename and settings: PUT /api/workspaces/7 -> 200 [application/json] {"id":7,"language":"zh","name":"Third","settings":{"z":true},"updatedAt":"<ts>"}
foreign settings: PUT /api/workspaces/2 -> 404 [application/json] {"error":"workspace_not_found","message":"No such workspace."}
grow 0: PUT /api/workspaces/5 -> 200 [application/json] {"id":5,"language":"ko","name":"Mine","settings":{"b":{"c":2,"d":3},"k0":""},"updatedAt":"<ts>"}
grow 1: PUT /api/workspaces/5 -> 200 [application/json] {"id":5,"language":"ko","name":"Mine","settings":{"b":{"c":2,"d":3},"k0":"","k1":""},"updatedAt":"<ts>"}
grow 2: PUT /api/workspaces/5 -> 200 [application/json] {"id":5,"language":"ko","name":"Mine","settings":{"b":{"c":2,"d":3},"k0":"","k1":"","k2":""},"updatedAt":"<ts>"}
grow 3: PUT /api/workspaces/5 -> 200 [application/json] {"id":5,"language":"ko","name":"Mine","settings":{"b":{"c":2,"d":3},"k0":"","k1":"","k2":"","k3":""},"updatedAt":"<ts>"}
grow 4: PUT /api/workspaces/5 -> 413 [application/json] {"error":"too_large","message":"The workspace settings would be larger than 64 KiB."}
body too large: PUT /api/workspaces/5 -> 413 [application/json] {"error":"too_large","message":"Request body too large."}
anonymous: PUT /api/workspaces/5 -> 401 [application/json] {"error":"unauthorized","message":"Sign in to continue."}

## delete
not a number: DELETE /api/workspaces/abc -> 404 [application/json] {"error":"workspace_not_found","message":"No such workspace."}
foreign: DELETE /api/workspaces/2 -> 404 [application/json] {"error":"workspace_not_found","message":"No such workspace."}
unknown: DELETE /api/workspaces/999 -> 404 [application/json] {"error":"workspace_not_found","message":"No such workspace."}
own: DELETE /api/workspaces/7 -> 204 [] 
again: DELETE /api/workspaces/7 -> 404 [application/json] {"error":"workspace_not_found","message":"No such workspace."}
carol defaults: GET /api/workspaces -> 200 [application/json] [{"id":9,"language":"es","name":"","settings":{},"updatedAt":"<ts>"}]
carol last: DELETE /api/workspaces/9 -> 409 [application/json] {"error":"last_workspace","message":"Keep at least one workspace."}
anonymous: DELETE /api/workspaces/5 -> 401 [application/json] {"error":"unauthorized","message":"Sign in to continue."}
bob list: GET /api/workspaces -> 200 [application/json] [{"id":1,"language":"es","name":"","settings":{},"updatedAt":"<ts>"},{"id":3,"language":"zh","name":"a‍b","settings":{},"updatedAt":"<ts>"},{"id":5,"language":"ko","name":"Mine","settings":{"b":{"c":2,"d":3},"k0":"","k1":"","k2":"","k3":""},"updatedAt":"<ts>"},{"id":6,"language":"zh","name":"Renamed","settings":{},"updatedAt":"<ts>"}]

## workspace checks of other routes
events foreign: GET /api/events?workspace=2 -> 404 [application/json] {"error":"workspace_not_found","message":"No such workspace."}
events own: GET /api/events?workspace=5 -> 200 [application/json] []
events batch foreign: POST /api/events/batch -> 404 [application/json] {"error":"workspace_not_found","message":"No such workspace."}
lookups foreign: DELETE /api/events/lookups?workspace=2 -> 404 [application/json] {"error":"workspace_not_found","message":"No such workspace."}
lookups own: DELETE /api/events/lookups?workspace=5 -> 200 [application/json] {"deleted":0}
activity foreign: GET /api/stats/activity?workspace=2 -> 404 [application/json] {"error":"workspace_not_found","message":"No such workspace."}
plugin data foreign: GET /api/plugins/qinqin-flashcards/data?workspace=2 -> 404 [application/json] {"error":"workspace_not_found","message":"No such workspace."}
plugin data own: GET /api/plugins/qinqin-flashcards/data?workspace=5 -> 404 [application/json] {"error":"not_found","message":"Plugin not found."}
journal foreign: GET /api/journal/capabilities?workspace=2 -> 404 [application/json] {"error":"workspace_not_found","message":"No such workspace."}
journal unknown: GET /api/journal/capabilities?workspace=999 -> 404 [application/json] {"error":"workspace_not_found","message":"No such workspace."}
journal own: GET /api/journal/capabilities?workspace=5 -> 200 [application/json] {"ai":{"secret":"missing","provider":"","fake":false,"key":null,"keys":[],"active":null,"models":[{"id":"claude-opus-5-5","label":"Claude Opus 5.5"},{"id":"claude-sonnet-5-5","label":"Claude Sonnet 5.5"},{"id":"claude-haiku-5-5","label":"Claude Haiku 5.5"}],"usage":{"callsLastHour":0,"limitPerHour":0,"inputTokens":0,"outputTokens":0},"available":false,"reason":"no_secret"},"ocr":{"available":false,"language":"ko","languageReady":false}}
packages: GET /api/packages -> 200 [application/json] {"format":1,"instanceId":"<id>","languages":["es","ko","zh"],"building":false,"packages":[]}

## admin languages
as user: POST /api/admin/languages -> 403 [application/json] {"error":"forbidden","message":"Administrator access is required."}
malformed: POST /api/admin/languages -> 400 [application/json] {"error":"bad_request","message":"Malformed request body."}
bad code: POST /api/admin/languages -> 422 [application/json] {"error":"invalid_language","message":"language must be a code like es or pt-br."}
built in: POST /api/admin/languages -> 409 [application/json] {"error":"language_built_in","message":"zh is built in."}
new: POST /api/admin/languages -> 201 [application/json] {"code":"fr","name":"fr","installed":false,"kind":"data"}
again: POST /api/admin/languages -> 200 [application/json] {"code":"fr","name":"fr","installed":false,"kind":"data"}
usage as user: GET /api/admin/languages/usage -> 403 [application/json] {"error":"forbidden","message":"Administrator access is required."}
usage: GET /api/admin/languages/usage -> 200 [application/json] [{"code":"es","workspaces":3},{"code":"ko","workspaces":2},{"code":"pt-br","workspaces":1},{"code":"zh","workspaces":2}]
languages: GET /api/languages -> 200 [application/json] [{"code":"es","name":"Spanish","installed":true,"kind":"data"},{"code":"fr","name":"fr","installed":false,"kind":"data"},{"code":"ja","name":"ja","installed":false,"kind":"code"},{"code":"ko","name":"ko","installed":false,"kind":"data"},{"code":"pt-br","name":"pt-br","installed":false,"kind":"data"},{"code":"zh","name":"zh","installed":false,"kind":"code"}]
delete in use (installed, workspaces): DELETE /api/admin/languages/es -> 409 [application/json] {"error":"language_in_use","message":"The language is still used by: 3 workspaces, installed dictionary data.","usage":{"audioPacks":0,"dictionaries":1,"frequencyPacks":0,"grammarPacks":0,"legacySentences":0,"levelLists":0,"sentencePacks":0,"workspaces":3}}
delete in use (workspaces): DELETE /api/admin/languages/ko -> 409 [application/json] {"error":"language_in_use","message":"The language is still used by: 2 workspaces.","usage":{"audioPacks":0,"dictionaries":0,"frequencyPacks":0,"grammarPacks":0,"legacySentences":0,"levelLists":0,"sentencePacks":0,"workspaces":2}}
delete in use (everything else): DELETE /api/admin/languages/de -> 409 [application/json] {"error":"language_in_use","message":"The language is still used by: 2 level lists, a frequency pack, a sentence pack, a grammar pack, a audio pack, sentences from an older pack without a registry row (remove with DELETE /api/admin/sentences/old-a, DELETE /api/admin/sentences/old-b).","usage":{"audioPacks":1,"dictionaries":0,"frequencyPacks":1,"grammarPacks":1,"legacySentences":1,"levelLists":2,"sentencePacks":1,"workspaces":0}}
delete built in: DELETE /api/admin/languages/ZH -> 409 [application/json] {"error":"language_built_in","message":"zh is built in."}
delete unknown: DELETE /api/admin/languages/xx -> 404 [application/json] {"error":"not_found","message":"No such language."}
delete as user: DELETE /api/admin/languages/fr -> 403 [application/json] {"error":"forbidden","message":"Administrator access is required."}
delete upper: DELETE /api/admin/languages/FR -> 204 [] 
delete again: DELETE /api/admin/languages/fr -> 404 [application/json] {"error":"not_found","message":"No such language."}
delete odd stored code: DELETE /api/admin/languages/Odd_Code -> 204 [] 
usage: GET /api/admin/languages/usage -> 200 [application/json] [{"code":"es","workspaces":3},{"code":"ko","workspaces":2},{"code":"pt-br","workspaces":1},{"code":"zh","workspaces":2}]
languages: GET /api/languages -> 200 [application/json] [{"code":"de","name":"de","installed":false,"kind":"data"},{"code":"es","name":"Spanish","installed":true,"kind":"data"},{"code":"ja","name":"ja","installed":false,"kind":"code"},{"code":"ko","name":"ko","installed":false,"kind":"data"},{"code":"pt-br","name":"pt-br","installed":false,"kind":"data"},{"code":"zh","name":"zh","installed":false,"kind":"code"}]

# audio

## packs and credits
packs: GET /api/audio-packs -> 200 [application/json] [{"packId":"zh-audio","name":"Test audio","version":"1","language":"zh","license":"per file","attribution":"Testers","notice":"Synthetic.","clipCount":2}]
credits: GET /api/audio-packs/zh-audio/credits -> 200 [application/json] {"total":2,"offset":0,"limit":100,"clips":[{"kind":"term","form":"你好","reading":"ni3hao3","license":"CC0","attribution":"Ann","source":"https://example.test/t"},{"kind":"syllable","form":"","reading":"xing2","license":"CC BY 4.0","attribution":"Bob","source":""}]}
page: GET /api/audio-packs/zh-audio/credits?offset=1&limit=1 -> 200 [application/json] {"total":2,"offset":1,"limit":1,"clips":[{"kind":"syllable","form":"","reading":"xing2","license":"CC BY 4.0","attribution":"Bob","source":""}]}
capped: GET /api/audio-packs/zh-audio/credits?limit=9999 -> 200 [application/json] {"total":2,"offset":0,"limit":500,"clips":[{"kind":"term","form":"你好","reading":"ni3hao3","license":"CC0","attribution":"Ann","source":"https://example.test/t"},{"kind":"syllable","form":"","reading":"xing2","license":"CC BY 4.0","attribution":"Bob","source":""}]}
past the end: GET /api/audio-packs/zh-audio/credits?offset=10 -> 200 [application/json] {"total":2,"offset":10,"limit":100,"clips":[]}
bad offset: GET /api/audio-packs/zh-audio/credits?offset=-1 -> 400 [application/json] {"error":"bad_request","message":"Bad offset."}
bad offset text: GET /api/audio-packs/zh-audio/credits?offset=x -> 400 [application/json] {"error":"bad_request","message":"Bad offset."}
bad limit: GET /api/audio-packs/zh-audio/credits?limit=0 -> 400 [application/json] {"error":"bad_request","message":"Bad limit."}
bad limit text: GET /api/audio-packs/zh-audio/credits?limit=x -> 400 [application/json] {"error":"bad_request","message":"Bad limit."}
bad offset before unknown pack: GET /api/audio-packs/nope/credits?offset=-1 -> 400 [application/json] {"error":"bad_request","message":"Bad offset."}
unknown pack: GET /api/audio-packs/nope/credits -> 404 [application/json] {"error":"not_found","message":"No such audio pack."}

