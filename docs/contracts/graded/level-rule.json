{
  "version": 1,
  "rule": "graded/level-rule",
  "doc": "How a graded text is counted against a word level list (README, Level rule). Inputs: the text, its names, the segmenter's matches (start/end in code points, the lemma, the lowest word level index of any entry or null, the function flag), the number of levels, the declared level and the glossed words. Go: server/internal/library/sources/graded/contract_test.go; web: apps/web/src/lib/features/reader/graded/levelRule.contract.test.ts.",
  "minCoveragePercent": 95,
  "maxAbove": 6,
  "cases": [
    {
      "name": "every word at the level: fits HSK 1",
      "text": "我是老师。",
      "names": [],
      "levels": 4,
      "declared": 0,
      "glosses": [],
      "tokens": [
        { "start": 0, "end": 1, "surface": "我", "lemma": "我", "level": 0, "function": false },
        { "start": 1, "end": 2, "surface": "是", "lemma": "是", "level": 0, "function": false },
        { "start": 2, "end": 4, "surface": "老师", "lemma": "老师", "level": 0, "function": false }
      ],
      "want": { "counted": 3, "within": 3, "above": [], "computedLevel": 0, "unglossed": [], "ok": true }
    },
    {
      "name": "function words and names are not counted",
      "text": "王明的书呢？",
      "names": ["王明"],
      "levels": 4,
      "declared": 0,
      "glosses": [],
      "tokens": [
        { "start": 0, "end": 1, "surface": "王", "lemma": "王", "level": 4, "function": false },
        { "start": 1, "end": 2, "surface": "明", "lemma": "明", "level": null, "function": false },
        { "start": 2, "end": 3, "surface": "的", "lemma": "的", "level": null, "function": true },
        { "start": 3, "end": 4, "surface": "书", "lemma": "书", "level": 0, "function": false },
        { "start": 4, "end": 5, "surface": "呢", "lemma": "呢", "level": null, "function": true }
      ],
      "want": { "counted": 1, "within": 1, "above": [], "computedLevel": 0, "unglossed": [], "ok": true }
    },
    {
      "name": "a token that only overlaps a name is left out too",
      "text": "小明天天来。",
      "names": ["小明"],
      "levels": 4,
      "declared": 0,
      "glosses": [],
      "tokens": [
        { "start": 0, "end": 1, "surface": "小", "lemma": "小", "level": 0, "function": false },
        { "start": 1, "end": 3, "surface": "明天", "lemma": "明天", "level": 0, "function": false },
        { "start": 3, "end": 4, "surface": "天", "lemma": "天", "level": 0, "function": false },
        { "start": 4, "end": 5, "surface": "来", "lemma": "来", "level": 0, "function": false }
      ],
      "want": { "counted": 2, "within": 2, "above": [], "computedLevel": 0, "unglossed": [], "ok": true }
    },
    {
      "name": "letters no match covers count as one unlisted word per run",
      "text": "我吃龘龘。",
      "names": [],
      "levels": 4,
      "declared": 0,
      "glosses": ["龘龘"],
      "tokens": [
        { "start": 0, "end": 1, "surface": "我", "lemma": "我", "level": 0, "function": false },
        { "start": 1, "end": 2, "surface": "吃", "lemma": "吃", "level": 0, "function": false }
