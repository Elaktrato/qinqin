   "event": {
    "id": "01KA0000000000000000000G15",
    "workspaceId": 7,
    "device": "web",
    "ts": "2026-11-19T08:00:00Z",
    "type": "grammar",
    "payload": {
     "point": "ppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppp:le",
     "mode": "lesson",
     "score": 1,
     "total": 1
    }
   },
   "expect": null
  },
  {
   "name": "a ts that is no time",
   "event": {
    "id": "01KA0000000000000000000G16",
    "workspaceId": 7,
    "device": "web",
    "ts": "yesterday",
    "type": "grammar",
    "payload": {
     "point": "p:l",
     "mode": "lesson",
     "score": 1,
     "total": 1
    }
   },
   "expect": null
  },
  {
   "name": "no payload",
   "event": {
    "id": "01KA0000000000000000000G17",
    "workspaceId": 7,
    "device": "web",
    "ts": "2026-11-19T08:00:00Z",
    "type": "grammar",
    "payload": null
   },
   "expect": null
  }
 ],
 "progress": [
  {
   "name": "no runs, no progress",
   "events": [],
   "expect": {}
  },
  {
   "name": "a lower score keeps the best, the last run is the last time",
   "events": [
    {
     "id": "01KA00000000000000000000G1",
     "workspaceId": 7,
     "device": "web",
     "ts": "2026-11-19T08:00:00Z",
     "type": "grammar",
     "payload": {
      "point": "p:a",
      "mode": "lesson",
      "score": 3,
      "total": 4
     }
    },
    {
     "id": "01KA00000000000000000000G2",
     "workspaceId": 7,
     "device": "web",
     "ts": "2026-11-20T08:00:00Z",
     "type": "grammar",
     "payload": {
      "point": "p:a",
      "mode": "lesson",
      "score": 1,
      "total": 4
     }
    }
   ],
   "expect": {
    "p:a": {
     "best": 3,
     "total": 4,
     "completedAt": "2026-11-20T08:00:00Z",
     "runs": 2
    }
   }
  },
  {
   "name": "a higher score is the new best",
   "events": [
    {
     "id": "01KA00000000000000000000G1",
     "workspaceId": 7,
     "device": "web",
     "ts": "2026-11-19T08:00:00Z",
     "type": "grammar",
     "payload": {
      "point": "p:a",
      "mode": "lesson",
      "score": 3,
      "total": 4
     }
    },
    {
     "id": "01KA00000000000000000000G2",
     "workspaceId": 7,
     "device": "web",
     "ts": "2026-11-20T08:00:00Z",
     "type": "grammar",
     "payload": {
      "point": "p:a",
      "mode": "lesson",
      "score": 4,
      "total": 4
     }
    }
   ],
   "expect": {
    "p:a": {
     "best": 4,
     "total": 4,
     "completedAt": "2026-11-20T08:00:00Z",
     "runs": 2
    }
   }
  },
  {
   "name": "another number of exercises starts over",
   "events": [
    {
     "id": "01KA00000000000000000000G1",
     "workspaceId": 7,
     "device": "web",
     "ts": "2026-11-19T08:00:00Z",
     "type": "grammar",
     "payload": {
      "point": "p:a",
      "mode": "lesson",
      "score": 4,
      "total": 4
     }
    },
    {
     "id": "01KA00000000000000000000G2",
     "workspaceId": 7,
     "device": "web",
     "ts": "2026-11-20T08:00:00Z",
     "type": "grammar",
     "payload": {
      "point": "p:a",
      "mode": "lesson",
      "score": 1,
      "total": 5
     }
    }
   ],
   "expect": {
    "p:a": {
     "best": 1,
     "total": 5,
     "completedAt": "2026-11-20T08:00:00Z",
     "runs": 2
    }
   }
  },
  {
   "name": "replayed by time, not by the log's order",
   "note": "the later run comes first in the list; the replay sorts by (instant, id)",
   "events": [
    {
     "id": "01KA00000000000000000000G2",
     "workspaceId": 7,
     "device": "web",
     "ts": "2026-11-20T08:00:00Z",
     "type": "grammar",
     "payload": {
      "point": "p:a",
      "mode": "lesson",
      "score": 1,
      "total": 5
     }
    },
    {
     "id": "01KA00000000000000000000G1",
     "workspaceId": 7,
     "device": "web",
     "ts": "2026-11-19T08:00:00Z",
     "type": "grammar",
     "payload": {
      "point": "p:a",
      "mode": "lesson",
      "score": 4,
      "total": 4
     }
    }
   ],
   "expect": {
    "p:a": {
     "best": 1,
     "total": 5,
     "completedAt": "2026-11-20T08:00:00Z",
     "runs": 2
    }
   }
  },
  {
   "name": "the same second replays in id order",
   "events": [
    {
     "id": "01KA00000000000000000000G2",
     "workspaceId": 7,
     "device": "web",
     "ts": "2026-11-19T08:00:00Z",
     "type": "grammar",
     "payload": {
      "point": "p:a",
      "mode": "lesson",
      "score": 2,
      "total": 2
     }
    },
    {
     "id": "01KA00000000000000000000G1",
     "workspaceId": 7,
     "device": "web",
     "ts": "2026-11-19T08:00:00Z",
     "type": "grammar",
     "payload": {
      "point": "p:a",
      "mode": "lesson",
      "score": 1,
      "total": 3
     }
    }
   ],
   "expect": {
    "p:a": {
     "best": 2,
     "total": 2,
     "completedAt": "2026-11-19T08:00:00Z",
     "runs": 2
    }
   }
  },
  {
   "name": "lessons of two packs are two points",
   "events": [
    {
     "id": "01KA00000000000000000000G1",
     "workspaceId": 7,
     "device": "web",
     "ts": "2026-11-19T08:00:00Z",
