 ],
 "legacy": [
  {
   "name": "a progress row is one run of its best score at its completedAt",
   "key": "grammar:progress:zh-grammar:le-change",
   "data": {
    "completedAt": "2026-11-19T08:00:00Z",
    "best": 3,
    "total": 4
   },
   "updatedAt": "2026-11-19T08:00:01Z",
   "expect": {
    "ts": "2026-11-19T08:00:00Z",
    "payload": {
     "point": "zh-grammar:le-change",
     "mode": "lesson",
     "score": 3,
     "total": 4
    }
   }
  },
  {
   "name": "the time becomes whole UTC seconds",
   "key": "grammar:progress:p:l",
   "data": {
    "completedAt": "2026-11-19T09:00:00.700+01:00",
    "best": 0,
    "total": 0
   },
   "updatedAt": "2026-11-19T08:00:01Z",
   "expect": {
    "ts": "2026-11-19T08:00:00Z",
    "payload": {
     "point": "p:l",
     "mode": "lesson",
     "score": 0,
     "total": 0
    }
   }
  },
  {
   "name": "a completedAt that is no time takes the write time",
   "key": "grammar:progress:p:l",
   "data": {
    "completedAt": "last tuesday",
    "best": 1,
    "total": 2
   },
   "updatedAt": "2026-11-20T10:00:00Z",
   "expect": {
    "ts": "2026-11-20T10:00:00Z",
    "payload": {
     "point": "p:l",
     "mode": "lesson",
     "score": 1,
     "total": 2
    }
   }
  },
  {
   "name": "no usable time at all is dropped",
   "key": "grammar:progress:p:l",
   "data": {
    "completedAt": "x",
    "best": 1,
    "total": 2
   },
   "updatedAt": "y",
   "expect": null
  },
  {
   "name": "a best above the total is dropped",
   "key": "grammar:progress:p:l",
   "data": {
    "completedAt": "2026-11-19T08:00:00Z",
    "best": 3,
    "total": 2
   },
   "updatedAt": "2026-11-19T08:00:00Z",
   "expect": null
  },
  {
   "name": "a lesson id that is no lesson id is dropped",
   "key": "grammar:progress:p:Le Change",
   "data": {
    "completedAt": "2026-11-19T08:00:00Z",
    "best": 1,
    "total": 2
   },
   "updatedAt": "2026-11-19T08:00:00Z",
   "expect": null
  },
  {
   "name": "a key without a lesson is dropped",
   "key": "grammar:progress:p",
   "data": {
    "completedAt": "2026-11-19T08:00:00Z",
    "best": 1,
    "total": 2
   },
   "updatedAt": "2026-11-19T08:00:00Z",
   "expect": null
  },
  {
   "name": "a missing best is dropped",
   "key": "grammar:progress:p:l",
   "data": {
    "completedAt": "2026-11-19T08:00:00Z",
    "total": 2
   },
   "updatedAt": "2026-11-19T08:00:00Z",
   "expect": null
  }
 ]
}
