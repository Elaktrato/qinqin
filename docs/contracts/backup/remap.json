     },
     {
      "type": "review",
      "workspaceId": 7,
      "payload": {
       "cardId": "c-vocab-2",
       "grade": 3
      }
     }
    ]
   },
   "expect": {
    "events": [
     {
      "drop": false,
      "workspaceId": 70,
      "payload": {
       "cardId": "c-vocab-2",
       "grade": 3
      }
     },
     {
      "drop": false,
      "workspaceId": 70,
      "payload": {
       "cardId": "c-vocab-1",
       "grade": 3
      }
     }
    ]
   },
   "note": ""
  },
  {
   "name": "review of a dropped card keeps history under orphan:",
