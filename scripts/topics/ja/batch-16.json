 "d": [
  {"i":2256,"keep":[],"n":"'Leave, withdraw' appears mostly in the set phrase お引き取りください; it is not a word taught in a movement unit"},
  {"i":2271,"keep":[],"n":"'Youngest child' is normally 末っ子; 末 alone in this sense is rare for learners"},
  {"i":2274,"keep":[2],"n":"Omakase as chef's choice of a meal is a common restaurant word and fits a food unit"},
  {"i":2276,"keep":[],"n":"The quarantine sense is marginal at this level; learners meet 隔離 for that"},
  {"i":2282,"keep":[3],"n":"お金を引き出す (withdraw money) is a core banking expression"},
  {"i":2288,"keep":[],"n":"Paying taxes or fees is written 納める, a different word, so this sense does not belong here"},
  {"i":2300,"keep":[1],"n":"Sermon or preaching is the base sense and fits a religion lesson in the culture unit"},
  {"i":2302,"keep":[2],"n":"Sharing files or posts is a very common modern use and fits technology"},
  {"i":2324,"keep":[2],"n":"Half-past, as in 3時半, is essential clock-time vocabulary"},
  {"i":2331,"keep":[6],"n":"新聞の一面 (newspaper front page) is common and fits media"},
  {"i":2336,"keep":[2],"n":"〜気味 (tendency, e.g. 風邪気味) is a standard N3 grammar suffix"},
  {"i":2339,"keep":[3],"n":"A model of a car or device (新しいモデル) is common and fits technology"},
  {"i":2348,"keep":[],"n":"Covering for or supporting someone is mostly workplace talk, not a relationships unit word"},
  {"i":2380,"keep":[],"n":"'Instance or situation' is an abstract noun and not a qualities word; no unit fits better than 't'"}
 ]
