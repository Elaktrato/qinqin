{
 "version": 1,
 "rule": "cards/hints",
 "note": "Hint kinds, their mode per card kind, the plan of one card and the grade rule (#215). Web: apps/web/src/lib/features/flashcards/face/hints.ts, decoded by hints.contract.test.ts. An entry is {hasReading, hasPicture, hasRomanisation} (hasRomanisation absent = false). romanisation (#284) is a derived kind: never stored, its mode follows `derived` (the reading kind: never stays never, always and hint become hint). entries: hintsForEntry with the hidden-romanisation setting (settings/romanisation.json).",
 "kinds": ["reading", "picture", "romanisation"],
 "modes": ["always", "hint", "never"],
 "notApplicable": [{ "kind": "reading", "cardKind": "tone" }, { "kind": "romanisation", "cardKind": "tone" }],
 "defaults": {
  "reading": { "vocab": "hint", "sentence": "hint", "writing": "always", "tone": "never", "reverse": "hint", "cloze": "hint" },
  "picture": { "vocab": "hint", "sentence": "never", "writing": "hint", "tone": "hint", "reverse": "hint", "cloze": "never" },
  "romanisation": { "vocab": "hint", "sentence": "hint", "writing": "hint", "tone": "never", "reverse": "hint", "cloze": "hint" }
 },
 "settings": [
  { "name": "no hints member: the defaults", "settings": {}, "expect": "defaults" },
  { "name": "null settings", "settings": null, "expect": "defaults" },
  {
   "name": "one cell changed, the rest default",
   "settings": { "hints": { "reading": { "vocab": "always" } } },
   "expect": {
    "reading": { "vocab": "always", "sentence": "hint", "writing": "always", "tone": "never", "reverse": "hint", "cloze": "hint" },
    "picture": "defaults"
   }
  },
  {
   "name": "a not-applicable cell is never, whatever is stored",
   "settings": { "hints": { "reading": { "tone": "always" } } },
   "expect": "defaults"
  },
  {
   "name": "unknown modes, kinds and card kinds are ignored",
   "settings": {
    "hints": { "reading": { "vocab": "sometimes", "reverse": 7, "karaoke": "always" }, "smell": { "vocab": "always" } }
   },
   "expect": "defaults"
  },
  { "name": "a hints member that is not an object is the defaults", "settings": { "hints": "always" }, "expect": "defaults" },
  {
   "name": "a kind member that is not an object is the defaults for that kind",
   "settings": { "hints": { "reading": ["always"], "picture": { "vocab": "never" } } },
   "expect": {
    "reading": "defaults",
    "picture": { "vocab": "never", "sentence": "never", "writing": "hint", "tone": "hint", "reverse": "hint", "cloze": "never" }
   }
  },
  {
   "name": "the romanisation row follows the reading row and a stored one is ignored",
   "settings": {
    "hints": {
     "reading": { "vocab": "never", "writing": "always", "cloze": "hint" },
     "romanisation": { "vocab": "always", "sentence": "never" }
    }
   },
   "expect": {
    "reading": { "vocab": "never", "sentence": "hint", "writing": "always", "tone": "never", "reverse": "hint", "cloze": "hint" },
    "romanisation": { "vocab": "never", "sentence": "hint", "writing": "hint", "tone": "never", "reverse": "hint", "cloze": "hint" }
   }
  }
 ],
 "plans": [
  {
   "name": "vocab: reading is a hint, the entry has no picture",
   "cardKind": "vocab",
   "settings": {},
   "entry": { "hasReading": true, "hasPicture": false },
   "always": [],
   "onRequest": ["reading"]
  },
  {
   "name": "writing: reading always shown by default",
   "cardKind": "writing",
   "settings": {},
   "entry": { "hasReading": true, "hasPicture": false },
   "always": ["reading"],
   "onRequest": []
  },
  {
   "name": "tone: reading never; a picture would be a hint",
   "cardKind": "tone",
   "settings": {},
   "entry": { "hasReading": true, "hasPicture": false },
   "always": [],
   "onRequest": []
  },
  {
   "name": "an entry without a reading offers no reading",
   "cardKind": "vocab",
   "settings": {},
   "entry": { "hasReading": false, "hasPicture": false },
   "always": [],
   "onRequest": []
  },
  {
   "name": "reading never",
   "cardKind": "reverse",
   "settings": { "hints": { "reading": { "reverse": "never" } } },
   "entry": { "hasReading": true, "hasPicture": false },
   "always": [],
   "onRequest": []
  },
  {
   "name": "an entry with a picture: both hints, in the fixed order reading then picture",
   "cardKind": "vocab",
   "settings": {},
   "entry": { "hasReading": true, "hasPicture": true },
   "always": [],
   "onRequest": ["reading", "picture"]
  },
  {
   "name": "picture always, reading as a hint",
   "cardKind": "vocab",
   "settings": { "hints": { "picture": { "vocab": "always" } } },
   "entry": { "hasReading": true, "hasPicture": true },
   "always": ["picture"],
   "onRequest": ["reading"]
  },
  {
   "name": "both always keep the fixed order",
   "cardKind": "reverse",
   "settings": { "hints": { "picture": { "reverse": "always" }, "reading": { "reverse": "always" } } },
   "entry": { "hasReading": true, "hasPicture": true },
   "always": ["reading", "picture"],
   "onRequest": []
  },
  {
   "name": "a picture setting without a picture shows nothing",
   "cardKind": "reverse",
   "settings": { "hints": { "picture": { "reverse": "always" } } },
   "entry": { "hasReading": true, "hasPicture": false },
   "always": [],
   "onRequest": ["reading"]
  },
  {
   "name": "forced modes (Starter, #214) win over the settings",
   "cardKind": "vocab",
   "settings": { "hints": { "reading": { "vocab": "never" } } },
   "forced": { "reading": "always", "picture": "hint" },
   "entry": { "hasReading": true, "hasPicture": true },
   "always": ["reading"],
   "onRequest": ["picture"]
  },
  {
   "name": "a forced mode cannot show what the entry lacks",
   "cardKind": "vocab",
   "settings": {},
   "forced": { "picture": "always" },
   "entry": { "hasReading": true, "hasPicture": false },
   "always": [],
   "onRequest": ["reading"]
  },
  {
   "name": "romanisation hidden: the shown readings first, the romanisation last",
   "cardKind": "vocab",
   "settings": {},
   "entry": { "hasReading": true, "hasPicture": true, "hasRomanisation": true },
   "always": [],
   "onRequest": ["reading", "picture", "romanisation"]
  },
  {
   "name": "every reading hidden: the romanisation hint alone",
   "cardKind": "reverse",
   "settings": {},
   "entry": { "hasReading": false, "hasPicture": false, "hasRomanisation": true },
   "always": [],
   "onRequest": ["romanisation"]
  },
  {
   "name": "writing: the shown reading always, the romanisation still a hint",
   "cardKind": "writing",
   "settings": {},
   "entry": { "hasReading": true, "hasPicture": false, "hasRomanisation": true },
   "always": ["reading"],
   "onRequest": ["romanisation"]
  },
  {
   "name": "tone: no romanisation hint (the pinyin is the answer)",
   "cardKind": "tone",
   "settings": {},
   "entry": { "hasReading": false, "hasPicture": false, "hasRomanisation": true },
   "always": [],
   "onRequest": []
  },
  {
   "name": "reading never: no romanisation hint either",
   "cardKind": "vocab",
   "settings": { "hints": { "reading": { "vocab": "never" } } },
   "entry": { "hasReading": true, "hasPicture": false, "hasRomanisation": true },
   "always": [],
   "onRequest": []
  },
  {
   "name": "a forced reading mode decides the romanisation too (Starter)",
   "cardKind": "vocab",
   "settings": {},
   "forced": { "reading": "never", "picture": "always" },
   "entry": { "hasReading": true, "hasPicture": true, "hasRomanisation": true },
   "always": ["picture"],
   "onRequest": []
  }
 ],
 "grades": [
  { "suggested": null, "used": 0, "expect": null },
  { "suggested": 3, "used": 0, "expect": 3 },
  { "suggested": null, "used": 1, "expect": 2, "note": "a self-graded card is treated as Good, so a hint suggests Hard" },
  { "suggested": 3, "used": 1, "expect": 2 },
  { "suggested": 3, "used": 2, "expect": 2, "note": "a second hint lowers no further" },
  { "suggested": 2, "used": 1, "expect": 2 },
  { "suggested": 1, "used": 1, "expect": 1, "note": "Again stays Again" },
  { "suggested": 4, "used": 1, "expect": 3, "note": "Easy goes down one step to Good" },
  { "suggested": 4, "used": 2, "expect": 3, "note": "a second hint lowers no further" }
 ],
 "results": [
  {
   "name": "no hint used: nothing changes",
   "result": { "suggested": 3, "meta": { "mistakes": 0 } },
   "used": 0,
   "expect": { "suggested": 3, "meta": { "mistakes": 0 } }
  },
  {
   "name": "one hint on a self-graded card",
   "result": { "suggested": null, "meta": {} },
   "used": 1,
   "expect": { "suggested": 2, "meta": { "hints": 1 } }
  },
  {
   "name": "hints add to the card's own help count",
   "result": { "suggested": 3, "meta": { "hints": 2, "mistakes": 1 } },
   "used": 2,
   "expect": { "suggested": 2, "meta": { "hints": 4, "mistakes": 1 } }
  },
  {
   "name": "a wrong answer keeps Again and still records the hint",
   "result": { "suggested": 1, "meta": { "mistakes": 1 } },
   "used": 1,
   "expect": { "suggested": 1, "meta": { "mistakes": 1, "hints": 1 } }
  }
 ],
 "storedKinds": ["reading", "picture"],
 "derived": { "romanisation": "reading" },
 "entries": [
  {
   "name": "nothing hidden: every reading is the reading hint",
   "readings": ["pinyin", "bopomofo"],
   "settings": {},
   "expect": { "hasReading": true, "hasRomanisation": false }
  },
  {
   "name": "pinyin hidden: bopomofo stays, pinyin is the romanisation hint",
   "readings": ["pinyin", "bopomofo"],
   "settings": { "romanisation": { "pinyin": "never" } },
   "expect": { "hasReading": true, "hasRomanisation": true }
  },
  {
   "name": "both hidden: only the romanisation hint",
   "readings": ["pinyin", "bopomofo"],
   "settings": { "romanisation": { "pinyin": "never", "bopomofo": "never" } },
   "expect": { "hasReading": false, "hasRomanisation": true }
  },
  {
   "name": "romaji hidden: kana is the reading hint",
   "readings": ["kana", "romaji"],
   "settings": { "romanisation": { "romaji": "never" } },
   "expect": { "hasReading": true, "hasRomanisation": true }
  },
  {
   "name": "no readings",
   "readings": [],
   "settings": { "romanisation": { "romaji": "never" } },
   "expect": { "hasReading": false, "hasRomanisation": false }
  }
 ]
}
