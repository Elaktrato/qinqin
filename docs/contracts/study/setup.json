{
 "version": 1,
 "rule": "study/setup",
 "key": "study-setup",
 "scope": "workspace",
 "note": "The saved study setup of a workspace (the study modal, 2026-11-25): what Start in the modal studies. Read field by field: a missing or bad member is that member's default, never the whole row; unknown members are kept on write; a newer version is read leniently and kept. cardTypes holds only the kinds that are not opt-in; an opt-in kind (reverse, cloze) is studied when a deck in scope switches it on and it is not in unchecked. repair runs after parse with what the reader knows (deck ids, installed schemes, the workspace language; null = not known yet, left alone).",
 "defaults": {"version": 1, "decks": "all", "mode": "decks", "schemeId": null, "levelName": null, "cardTypes": ["vocab"], "unchecked": [], "newLimit": 20, "reviewLimit": 100, "newOrder": "random", "typeOrder": "mixed"},
 "parse": [
  {"name": "no row is the defaults", "row": null,
   "expect": {"version": 1, "decks": "all", "mode": "decks", "schemeId": null, "levelName": null, "cardTypes": ["vocab"], "unchecked": [], "newLimit": 20, "reviewLimit": 100, "newOrder": "random", "typeOrder": "mixed"}},
  {"name": "a full row reads as it is", "row": {"version": 1, "decks": ["general", "01JD0000000000000000000001"], "mode": "levels", "schemeId": 3, "levelName": "HSK 2", "cardTypes": ["vocab", "writing"], "unchecked": ["cloze"], "newLimit": 15, "reviewLimit": 80, "newOrder": {"by": "frequency"}, "typeOrder": "grouped"},
   "expect": {"version": 1, "decks": ["general", "01JD0000000000000000000001"], "mode": "levels", "schemeId": 3, "levelName": "HSK 2", "cardTypes": ["vocab", "writing"], "unchecked": ["cloze"], "newLimit": 15, "reviewLimit": 80, "newOrder": {"by": "frequency"}, "typeOrder": "grouped"}},
  {"name": "each bad member falls back on its own", "row": {"version": 1, "decks": "some", "mode": "weekly", "schemeId": -2, "levelName": "", "cardTypes": "vocab", "unchecked": ["reverse", "vocab", "reverse"], "newLimit": 0, "reviewLimit": 1000, "newOrder": "sideways", "typeOrder": 7},
   "expect": {"version": 1, "decks": "all", "mode": "decks", "schemeId": null, "levelName": null, "cardTypes": ["vocab"], "unchecked": ["reverse"], "newLimit": 20, "reviewLimit": 100, "newOrder": "random", "typeOrder": "mixed"}},
  {"name": "an empty deck list is all decks", "row": {"version": 1, "decks": []},
   "expect": {"version": 1, "decks": "all", "mode": "decks", "schemeId": null, "levelName": null, "cardTypes": ["vocab"], "unchecked": [], "newLimit": 20, "reviewLimit": 100, "newOrder": "random", "typeOrder": "mixed"}},
  {"name": "opt-in kinds and unknown kinds leave cardTypes; only opt-in kinds is an empty list", "row": {"version": 1, "cardTypes": ["reverse", "cloze"]},
   "expect": {"version": 1, "decks": "all", "mode": "decks", "schemeId": null, "levelName": null, "cardTypes": [], "unchecked": [], "newLimit": 20, "reviewLimit": 100, "newOrder": "random", "typeOrder": "mixed"}},
  {"name": "no known kind at all is the default", "row": {"version": 1, "cardTypes": ["handwriting"]},
   "expect": {"version": 1, "decks": "all", "mode": "decks", "schemeId": null, "levelName": null, "cardTypes": ["vocab"], "unchecked": [], "newLimit": 20, "reviewLimit": 100, "newOrder": "random", "typeOrder": "mixed"}},
  {"name": "a newer version is read leniently", "row": {"version": 2, "decks": "all", "cardTypes": ["vocab", "tone"], "newOrder": "deck", "future": {"x": 1}},
   "expect": {"version": 2, "decks": "all", "mode": "decks", "schemeId": null, "levelName": null, "cardTypes": ["vocab", "tone"], "unchecked": [], "newLimit": 20, "reviewLimit": 100, "newOrder": "deck", "typeOrder": "mixed"}},
  {"name": "a bad version reads as 1", "row": {"version": "two", "newLimit": 30},
   "expect": {"version": 1, "decks": "all", "mode": "decks", "schemeId": null, "levelName": null, "cardTypes": ["vocab"], "unchecked": [], "newLimit": 30, "reviewLimit": 100, "newOrder": "random", "typeOrder": "mixed"}}
 ],
 "repair": [
  {"name": "a level of an uninstalled scheme falls back to the decks, the selection kept",
   "row": {"version": 1, "decks": ["d1"], "mode": "levels", "schemeId": 9, "levelName": "N5"},
   "context": {"decks": ["d1"], "schemes": [{"id": 3, "language": "ja", "levels": ["N5", "N4"]}], "language": "ja"},
   "expect": {"version": 1, "decks": ["d1"], "mode": "decks", "schemeId": 9, "levelName": "N5", "cardTypes": ["vocab"], "unchecked": [], "newLimit": 20, "reviewLimit": 100, "newOrder": "random", "typeOrder": "mixed"},
   "notes": ["levelGone"]},
  {"name": "a scheme of another language falls back to the decks",
   "row": {"version": 1, "mode": "levels", "schemeId": 3, "levelName": "N5"},
   "context": {"decks": [], "schemes": [{"id": 3, "language": "ja", "levels": ["N5"]}], "language": "zh"},
   "expect": {"version": 1, "decks": "all", "mode": "decks", "schemeId": 3, "levelName": "N5", "cardTypes": ["vocab"], "unchecked": [], "newLimit": 20, "reviewLimit": 100, "newOrder": "random", "typeOrder": "mixed"},
   "notes": ["levelGone"]},
  {"name": "a level no longer in its scheme falls back to the decks",
   "row": {"version": 1, "mode": "levels", "schemeId": 3, "levelName": "N1"},
   "context": {"decks": [], "schemes": [{"id": 3, "language": "ja", "levels": ["N5"]}], "language": "ja"},
   "expect": {"version": 1, "decks": "all", "mode": "decks", "schemeId": 3, "levelName": "N1", "cardTypes": ["vocab"], "unchecked": [], "newLimit": 20, "reviewLimit": 100, "newOrder": "random", "typeOrder": "mixed"},
   "notes": ["levelGone"]},
  {"name": "a level mode without a scheme falls back even before the schemes are known",
   "row": {"version": 1, "mode": "levels"},
   "context": {"decks": null, "schemes": null, "language": "ja"},
   "expect": {"version": 1, "decks": "all", "mode": "decks", "schemeId": null, "levelName": null, "cardTypes": ["vocab"], "unchecked": [], "newLimit": 20, "reviewLimit": 100, "newOrder": "random", "typeOrder": "mixed"},
   "notes": ["levelGone"]},
  {"name": "schemes not known yet leave a level alone",
   "row": {"version": 1, "mode": "levels", "schemeId": 9, "levelName": "N5"},
   "context": {"decks": null, "schemes": null, "language": "ja"},
   "expect": {"version": 1, "decks": "all", "mode": "levels", "schemeId": 9, "levelName": "N5", "cardTypes": ["vocab"], "unchecked": [], "newLimit": 20, "reviewLimit": 100, "newOrder": "random", "typeOrder": "mixed"},
   "notes": []},
  {"name": "a failed read of the schemes is not knowing them: the level stays",
   "row": {"version": 1, "mode": "levels", "schemeId": 3, "levelName": "HSK 2"},
   "context": {"decks": null, "schemes": null, "language": "zh"},
   "expect": {"version": 1, "decks": "all", "mode": "levels", "schemeId": 3, "levelName": "HSK 2", "cardTypes": ["vocab"], "unchecked": [], "newLimit": 20, "reviewLimit": 100, "newOrder": "random", "typeOrder": "mixed"},
   "notes": []},
  {"name": "a level that exists stays",
   "row": {"version": 1, "mode": "levels", "schemeId": 3, "levelName": "N4"},
   "context": {"decks": [], "schemes": [{"id": 3, "language": "ja", "levels": ["N5", "N4"]}], "language": "ja"},
   "expect": {"version": 1, "decks": "all", "mode": "levels", "schemeId": 3, "levelName": "N4", "cardTypes": ["vocab"], "unchecked": [], "newLimit": 20, "reviewLimit": 100, "newOrder": "random", "typeOrder": "mixed"},
   "notes": []},
  {"name": "an explicit list with no deck left is all decks",
   "row": {"version": 1, "decks": ["gone1", "gone2"]},
   "context": {"decks": ["d1"], "schemes": null, "language": "ja"},
   "expect": {"version": 1, "decks": "all", "mode": "decks", "schemeId": null, "levelName": null, "cardTypes": ["vocab"], "unchecked": [], "newLimit": 20, "reviewLimit": 100, "newOrder": "random", "typeOrder": "mixed"},
   "notes": ["decksGone"]},
  {"name": "General always exists and a partly gone list stays as chosen",
   "row": {"version": 1, "decks": ["general", "gone1"]},
   "context": {"decks": [], "schemes": null, "language": "ja"},
   "expect": {"version": 1, "decks": ["general", "gone1"], "mode": "decks", "schemeId": null, "levelName": null, "cardTypes": ["vocab"], "unchecked": [], "newLimit": 20, "reviewLimit": 100, "newOrder": "random", "typeOrder": "mixed"},
   "notes": []},
  {"name": "decks not known yet leave the list alone",
   "row": {"version": 1, "decks": ["gone1"]},
   "context": {"decks": null, "schemes": null, "language": "ja"},
   "expect": {"version": 1, "decks": ["gone1"], "mode": "decks", "schemeId": null, "levelName": null, "cardTypes": ["vocab"], "unchecked": [], "newLimit": 20, "reviewLimit": 100, "newOrder": "random", "typeOrder": "mixed"},
   "notes": []},
  {"name": "kinds the language does not offer are dropped",
   "row": {"version": 1, "cardTypes": ["vocab", "tone"]},
   "context": {"decks": null, "schemes": null, "language": "ja"},
   "expect": {"version": 1, "decks": "all", "mode": "decks", "schemeId": null, "levelName": null, "cardTypes": ["vocab"], "unchecked": [], "newLimit": 20, "reviewLimit": 100, "newOrder": "random", "typeOrder": "mixed"},
   "notes": []},
  {"name": "none left is the defaults, and the reader is told",
   "row": {"version": 1, "cardTypes": ["writing", "tone"]},
   "context": {"decks": null, "schemes": null, "language": "es"},
   "expect": {"version": 1, "decks": "all", "mode": "decks", "schemeId": null, "levelName": null, "cardTypes": ["vocab"], "unchecked": [], "newLimit": 20, "reviewLimit": 100, "newOrder": "random", "typeOrder": "mixed"},
   "notes": ["typesGone"]},
  {"name": "an empty kind list (opt-in kinds only) is not repaired",
   "row": {"version": 1, "cardTypes": []},
   "context": {"decks": null, "schemes": null, "language": "es"},
   "expect": {"version": 1, "decks": "all", "mode": "decks", "schemeId": null, "levelName": null, "cardTypes": [], "unchecked": [], "newLimit": 20, "reviewLimit": 100, "newOrder": "random", "typeOrder": "mixed"},
   "notes": []}
 ],
 "write": [
  {"name": "a first write", "stored": null,
   "next": {"version": 1, "decks": "all", "mode": "decks", "schemeId": null, "levelName": null, "cardTypes": ["vocab", "writing"], "unchecked": [], "newLimit": 20, "reviewLimit": 100, "newOrder": "random", "typeOrder": "mixed"},
   "expect": {"version": 1, "decks": "all", "mode": "decks", "schemeId": null, "levelName": null, "cardTypes": ["vocab", "writing"], "unchecked": [], "newLimit": 20, "reviewLimit": 100, "newOrder": "random", "typeOrder": "mixed"}},
  {"name": "unknown members of the stored row are kept", "stored": {"version": 1, "decks": "all", "future": {"x": 1}, "newLimit": 5},
   "next": {"version": 1, "decks": ["d1"], "mode": "decks", "schemeId": null, "levelName": null, "cardTypes": ["vocab"], "unchecked": ["reverse"], "newLimit": 10, "reviewLimit": 100, "newOrder": {"by": "added"}, "typeOrder": "grouped"},
   "expect": {"version": 1, "decks": ["d1"], "future": {"x": 1}, "mode": "decks", "schemeId": null, "levelName": null, "cardTypes": ["vocab"], "unchecked": ["reverse"], "newLimit": 10, "reviewLimit": 100, "newOrder": {"by": "added"}, "typeOrder": "grouped"}},
  {"name": "a newer stored version is kept", "stored": {"version": 2, "extra": true},
   "next": {"version": 1, "decks": "all", "mode": "decks", "schemeId": null, "levelName": null, "cardTypes": ["vocab"], "unchecked": [], "newLimit": 20, "reviewLimit": 100, "newOrder": "random", "typeOrder": "mixed"},
   "expect": {"version": 2, "extra": true, "decks": "all", "mode": "decks", "schemeId": null, "levelName": null, "cardTypes": ["vocab"], "unchecked": [], "newLimit": 20, "reviewLimit": 100, "newOrder": "random", "typeOrder": "mixed"}},
  {"name": "a stored value that is not an object starts fresh", "stored": "garbage",
   "next": {"version": 1, "decks": "all", "mode": "decks", "schemeId": null, "levelName": null, "cardTypes": ["vocab"], "unchecked": [], "newLimit": 20, "reviewLimit": 100, "newOrder": "random", "typeOrder": "mixed"},
   "expect": {"version": 1, "decks": "all", "mode": "decks", "schemeId": null, "levelName": null, "cardTypes": ["vocab"], "unchecked": [], "newLimit": 20, "reviewLimit": 100, "newOrder": "random", "typeOrder": "mixed"}}
 ]
}
