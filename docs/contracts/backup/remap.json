     }
    ],
    "events": [
     {
      "type": "review",
      "workspaceId": 7,
      "payload": {
       "cardId": "c-vocab-9",
       "mode": "vocab",
       "grade": 1
      }
     }
    ]
   },
   "expect": {
    "events": [
     {
      "drop": false,
      "workspaceId": 70,
      "payload": {
       "cardId": "orphan:c-vocab-9",
       "mode": "vocab",
       "grade": 1
      }
     }
    ]
   },
   "note": ""
  },
