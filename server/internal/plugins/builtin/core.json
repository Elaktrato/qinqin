{
	"id": "qinqin-core",
	"name": "Core",
	"version": "1.2",
	"type": "feature",
	"sdk": 1,
	"description": "The core app: home layout, study sessions, flashcard reviews, reading, view and lookup activity.",
	"surfaces": [],
	"permissions": ["owns-data", "write:study-events"],
	"hooks": [],
	"events": [{ "type": "session" }, { "type": "view" }, { "type": "lookup" }, { "type": "review", "activity": { "label": "Flashcard reviews", "describe": { "one": "{n} flashcard review", "other": "{n} flashcard reviews" } } }, { "type": "read", "activity": { "label": "Reading", "describe": { "one": "{n} minute of reading", "other": "{n} minutes of reading" }, "measure": { "field": "seconds", "unit": "seconds", "min": 30, "max": 7200 }, "pointsPer": 300 } }]
}
