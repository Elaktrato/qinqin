{
 "version": 1,
 "rule": "reader/saved-sentences",
 "doc": "Saved sentences (#279): the book sentence a studied word is met in becomes an own sentence of the entry and a sentence (Word Salad) card. normalize and same: Go server/internal/sentences/saved_contract_test.go and web lib/features/reader/savedSentences.test.ts; plan and auto: web; remove: Go server/internal/sentences/saved_contract_test.go.",
 "whitespace": ["\t", "\n", "\u000b", "\f", "\r", " ", "\u0085", " ", " ", " ", " ", " ", " ", " ", " ", " ", " ", " ", " ", " ", " ", " ", " ", " ", "　", "﻿"],
 "normalize": [
  { "name": "plain text is unchanged", "text": "我喜欢学习。", "want": "我喜欢学习。" },
  { "name": "the ends are trimmed", "text": "  我喜欢学习。\n", "want": "我喜欢学习。" },
  { "name": "a run of whitespace becomes one space", "text": "I  like\t\tto\nread.", "want": "I like to read." },
  { "name": "an ideographic space counts", "text": "　我　　喜欢。", "want": "我 喜欢。" },
  { "name": "a no-break space and a narrow no-break space count", "text": "a b c", "want": "a b c" },
  { "name": "NEL and the byte order mark count", "text": "﻿a\u0085b", "want": "a b" },
  { "name": "a zero-width space does not count", "text": "a​b", "want": "a​b" },
  { "name": "punctuation and width are not folded", "text": "你好!", "want": "你好!" },
  { "name": "only whitespace is empty", "text": " 　\n", "want": "" }
 ],
 "same": [
  { "name": "no sentences", "sentences": [], "text": "我喜欢学习。", "want": null },
  { "name": "equal text", "sentences": [{ "id": 4, "hanzi": "我喜欢学习。" }], "text": "我喜欢学习。", "want": 4 },
  { "name": "equal after normalising both", "sentences": [{ "id": 4, "hanzi": " 我 喜欢\n学习。" }], "text": "我　喜欢 学习。 ", "want": 4 },
  { "name": "the first of two equal sentences", "sentences": [{ "id": 9, "hanzi": "我喜欢学习。" }, { "id": 4, "hanzi": "我喜欢学习。" }], "text": "我喜欢学习。", "want": 9 },
  { "name": "different punctuation is another sentence", "sentences": [{ "id": 4, "hanzi": "我喜欢学习。" }], "text": "我喜欢学习！", "want": null },
  { "name": "a longer sentence is another sentence", "sentences": [{ "id": 4, "hanzi": "我喜欢学习。" }], "text": "我很喜欢学习。", "want": null },
  { "name": "empty text matches nothing", "sentences": [{ "id": 4, "hanzi": " " }], "text": "　", "want": null }
 ],
 "plan": [
  { "name": "a new sentence is saved with a card in the word's decks",
    "entryId": 7, "entryKind": "word", "text": "他在学习。",
    "sentences": [{ "id": 1, "hanzi": "我喜欢学习。" }],
    "cards": [{ "id": "v7", "kind": "vocab", "entryId": 7, "written": "学习", "deckIds": ["general", "d1"], "createdAt": "2026-11-01T00:00:00Z" }],
    "want": { "action": "save", "text": "他在学习。", "card": { "deckIds": ["general", "d1"], "written": "学习" } } },
  { "name": "an existing sentence without a sentence card gets one",
    "entryId": 7, "entryKind": "word", "text": "我喜欢 学习。",
    "sentences": [{ "id": 1, "hanzi": "我喜欢　学习。" }],
    "cards": [{ "id": "v7", "kind": "vocab", "entryId": 7, "sentenceId": 1, "written": "学习", "deckIds": ["general"], "createdAt": "2026-11-01T00:00:00Z" }],
    "want": { "action": "card", "sentenceId": 1, "card": { "deckIds": ["general"], "written": "学习" } } },
  { "name": "a sentence that has its card is already saved",
    "entryId": 7, "entryKind": "word", "text": "我喜欢学习。",
    "sentences": [{ "id": 1, "hanzi": "我喜欢学习。" }],
    "cards": [
     { "id": "v7", "kind": "vocab", "entryId": 7, "deckIds": ["general"], "createdAt": "2026-11-01T00:00:00Z" },
     { "id": "s7", "kind": "sentence", "entryId": 7, "sentenceId": 1, "deckIds": ["general"], "createdAt": "2026-11-02T00:00:00Z" }],
    "want": { "action": "already", "sentenceId": 1 } },
  { "name": "another sentence's card does not count",
    "entryId": 7, "entryKind": "word", "text": "他在学习。",
    "sentences": [{ "id": 1, "hanzi": "我喜欢学习。" }, { "id": 2, "hanzi": "他在学习。" }],
    "cards": [
     { "id": "v7", "kind": "vocab", "entryId": 7, "deckIds": ["general"], "createdAt": "2026-11-01T00:00:00Z" },
     { "id": "s7", "kind": "sentence", "entryId": 7, "sentenceId": 1, "deckIds": ["general"], "createdAt": "2026-11-02T00:00:00Z" }],
    "want": { "action": "card", "sentenceId": 2, "card": { "deckIds": ["general"] } } },
  { "name": "no limit: a word with many sentence cards still saves a new one",
    "entryId": 7, "entryKind": "word", "text": "第四句学习。",
    "sentences": [{ "id": 1, "hanzi": "一学习。" }, { "id": 2, "hanzi": "二学习。" }, { "id": 3, "hanzi": "三学习。" }],
    "cards": [
     { "id": "v7", "kind": "vocab", "entryId": 7, "deckIds": ["general"], "createdAt": "2026-11-01T00:00:00Z" },
     { "id": "s1", "kind": "sentence", "entryId": 7, "sentenceId": 1, "deckIds": ["general"], "createdAt": "2026-11-02T00:00:00Z" },
     { "id": "s2", "kind": "sentence", "entryId": 7, "sentenceId": 2, "deckIds": ["general"], "createdAt": "2026-11-02T00:00:00Z" },
     { "id": "s3", "kind": "sentence", "entryId": 7, "sentenceId": 3, "deckIds": ["general"], "createdAt": "2026-11-02T00:00:00Z" }],
    "want": { "action": "save", "text": "第四句学习。", "card": { "deckIds": ["general"] } } },
  { "name": "the word's canonical vocab card gives the decks (the oldest)",
    "entryId": 7, "entryKind": "word", "text": "他在学习。",
    "sentences": [],
    "cards": [
     { "id": "v7b", "kind": "vocab", "entryId": 7, "deckIds": ["d2"], "createdAt": "2026-11-05T00:00:00Z" },
     { "id": "v7a", "kind": "vocab", "entryId": 7, "deckIds": ["d1"], "createdAt": "2026-11-01T00:00:00Z" }],
    "want": { "action": "save", "text": "他在学习。", "card": { "deckIds": ["d1"] } } },
  { "name": "a word that skips sentence cards saves the sentence without a card",
    "entryId": 7, "entryKind": "word", "text": "他在学习。",
    "sentences": [],
    "cards": [{ "id": "v7", "kind": "vocab", "entryId": 7, "skipKinds": ["sentence"], "deckIds": ["general"], "createdAt": "2026-11-01T00:00:00Z" }],
    "want": { "action": "save", "text": "他在学习。", "card": null } },
  { "name": "a skipped word's existing sentence: nothing to do",
    "entryId": 7, "entryKind": "word", "text": "他在学习。",
    "sentences": [{ "id": 2, "hanzi": "他在学习。" }],
    "cards": [{ "id": "v7", "kind": "vocab", "entryId": 7, "skipKinds": ["sentence"], "deckIds": ["general"], "createdAt": "2026-11-01T00:00:00Z" }],
    "want": { "action": "already", "sentenceId": 2 } },
  { "name": "a word that is not in study: nothing",
    "entryId": 7, "entryKind": "word", "text": "他在学习。",
    "sentences": [],
    "cards": [{ "id": "w7", "kind": "writing", "entryId": 7, "deckIds": ["general"], "createdAt": "2026-11-01T00:00:00Z" }],
    "want": { "action": "none" } },
  { "name": "a character result: nothing",
    "entryId": 7, "entryKind": "character", "text": "他在学习。",
    "sentences": [],
    "cards": [{ "id": "v7", "kind": "vocab", "entryId": 7, "deckIds": ["general"], "createdAt": "2026-11-01T00:00:00Z" }],
    "want": { "action": "none" } },
  { "name": "no sentence beyond the word: nothing",
    "entryId": 7, "entryKind": "word", "text": " 　",
    "sentences": [],
    "cards": [{ "id": "v7", "kind": "vocab", "entryId": 7, "deckIds": ["general"], "createdAt": "2026-11-01T00:00:00Z" }],
    "want": { "action": "none" } },
  { "name": "the text is stored normalised",
    "entryId": 7, "entryKind": "word", "text": "  他\n在学习。 ",
    "sentences": [],
    "cards": [{ "id": "v7", "kind": "vocab", "entryId": 7, "deckIds": ["general"], "createdAt": "2026-11-01T00:00:00Z" }],
    "want": { "action": "save", "text": "他 在学习。", "card": { "deckIds": ["general"] } } }
 ],
 "auto": [
  { "name": "everything holds", "settings": { "reader": { "saveSentences": true } }, "first": true, "paragraph": true, "entryKind": "word", "inStudyAtOpen": true, "want": true },
  { "name": "off by default", "settings": {}, "first": true, "paragraph": true, "entryKind": "word", "inStudyAtOpen": true, "want": false },
  { "name": "no settings at all", "settings": null, "first": true, "paragraph": true, "entryKind": "word", "inStudyAtOpen": true, "want": false },
  { "name": "switched off", "settings": { "reader": { "saveSentences": false } }, "first": true, "paragraph": true, "entryKind": "word", "inStudyAtOpen": true, "want": false },
  { "name": "not a boolean is off", "settings": { "reader": { "saveSentences": "yes" } }, "first": true, "paragraph": true, "entryKind": "word", "inStudyAtOpen": true, "want": false },
  { "name": "not the first result of the popup", "settings": { "reader": { "saveSentences": true } }, "first": false, "paragraph": true, "entryKind": "word", "inStudyAtOpen": true, "want": false },
  { "name": "a nested popup (no paragraph)", "settings": { "reader": { "saveSentences": true } }, "first": true, "paragraph": false, "entryKind": "word", "inStudyAtOpen": true, "want": false },
  { "name": "a character", "settings": { "reader": { "saveSentences": true } }, "first": true, "paragraph": true, "entryKind": "character", "inStudyAtOpen": true, "want": false },
  { "name": "not in study when the popup opened", "settings": { "reader": { "saveSentences": true } }, "first": true, "paragraph": true, "entryKind": "word", "inStudyAtOpen": false, "want": false }
 ],
 "remove": [
  { "name": "an own sentence", "sentence": "own", "caller": "owner", "reason": "", "want": 204 },
  { "name": "a kept AI example", "sentence": "ai", "caller": "owner", "reason": "", "want": 204 },
  { "name": "a kept AI example, reported", "sentence": "ai", "caller": "owner", "reason": "wrong_translation", "want": 204 },
  { "name": "an own sentence cannot be reported", "sentence": "own", "caller": "owner", "reason": "unnatural", "want": 400 },
  { "name": "a pack sentence", "sentence": "pack", "caller": "owner", "reason": "", "want": 404 },
  { "name": "another user's sentence", "sentence": "own", "caller": "other", "reason": "", "want": 404 },
  { "name": "an unknown reason", "sentence": "ai", "caller": "owner", "reason": "spam", "want": 400 }
 ]
}
