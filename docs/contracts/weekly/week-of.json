      "param": "2026-12-01",
      "expect": "2026-11-16"
    },
    {
      "name": "60 weeks back is clamped to 52 weeks back",
      "op": "normalize",
      "today": "2026-11-18",
      "param": "2025-09-22",
      "expect": "2025-11-17"
    },
    {
      "name": "exactly 52 weeks back stays",
      "op": "normalize",
      "today": "2026-11-18",
      "param": "2025-11-17",
      "expect": "2025-11-17"
    },
    {
      "name": "garbage is the current week",
      "op": "normalize",
      "today": "2026-11-18",
      "param": "garbage",
      "expect": "2026-11-16"
    },
    {
      "name": "a date that does not exist is the current week",
