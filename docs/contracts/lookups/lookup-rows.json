{
  "version": 1,
  "rule": "lookups/rows",
  "_doc": "Parse rules of the qinqin-core lookups (per workspace) and lookupcfg (user-global) rows (docs/contracts/lookups/README.md). op rows: input {data, deletedAt} -> {clearedAt, items, extra}; op cfg: -> {record, extra}. A tombstone (deletedAt set) is a missing row. Web: lib/lookups/lookups.test.ts.",
  "cases": [
    {
      "name": "valid row",
      "op": "rows",
      "input": {
        "data": {
          "version": 1,
          "clearedAt": null,
          "items": [
            {
              "entryId": 1201,
              "count": 4,
              "firstAt": "2026-11-10T09:00:00Z",
              "lastAt": "2026-11-15T07:05:00.250Z",
              "sources": {
                "reader": 3,
                "search": 1
              },
              "books": [
                17,
                4
              ]
            },
            {
              "entryId": 88,
              "count": 1,
              "firstAt": "2026-11-12T18:30:00Z",
              "lastAt": "2026-11-12T18:30:00Z",
              "sources": {
                "lesson": 1
              },
              "books": []
            }
          ]
        },
        "deletedAt": null
      },
      "expect": {
        "clearedAt": null,
        "items": [
          {
            "entryId": 1201,
            "count": 4,
            "firstAt": "2026-11-10T09:00:00Z",
            "lastAt": "2026-11-15T07:05:00.250Z",
            "sources": {
              "reader": 3,
              "search": 1
            },
            "books": [
              17,
              4
            ]
          },
          {
            "entryId": 88,
            "count": 1,
            "firstAt": "2026-11-12T18:30:00Z",
            "lastAt": "2026-11-12T18:30:00Z",
            "sources": {
              "lesson": 1
            },
            "books": []
          }
        ],
        "extra": {}
      }
    },
    {
      "name": "missing row is an empty history",
      "op": "rows",
      "input": {
        "data": null,
        "deletedAt": null
      },
      "expect": {
        "clearedAt": null,
        "items": [],
        "extra": {}
      }
    },
    {
      "name": "tombstoned row is an empty history",
      "op": "rows",
